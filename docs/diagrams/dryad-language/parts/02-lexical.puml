@startuml dryad_02_lexical
title Dryad Language — Lexical & Surface Syntax
skinparam backgroundColor #FEFEFE
skinparam shadowing false
skinparam defaultFontSize 10

package "Token Categories" as TOK #E3F2FD {

  package "Literals" {
    enum LiteralTokens {
      Identifier
      IntegerLiteral
      FloatLiteral
      StringLiteral
      BooleanLiteral  // true, false
      NullLiteral     // null
    }
  }

  package "Arithmetic Operators" {
    enum ArithOps {
      +  // Plus
      -  // Minus
      *  // Star
      /  // Slash
      %  // Percent
    }
  }

  package "Comparison Operators" {
    enum CmpOps {
      ==  // EqualEqual
      !=  // BangEqual
      <   // Less
      <=  // LessEqual
      >   // Greater
      >=  // GreaterEqual
    }
  }

  package "Compound Assignment" {
    enum CompoundAssign {
      +=  // PlusEqual
      -=  // MinusEqual
      *=  // StarEqual
      /=  // SlashEqual
    }
  }

  package "Logical Operators" {
    enum LogicOps {
      !   // Bang (unary not)
      &&  // AmpersandAmpersand
      ||  // PipePipe
    }
  }

  package "Delimiters & Punctuation" {
    enum Delimiters {
      ( ) { } [ ]
      , . : ; -> ?
      @   // decorator prefix
      #   // reserved (module/intrinsic names)
    }
  }
}

package "Reserved Keywords (37)" as KW #FFF3E0 {
  together {
    card "Declarations" as KW_DECL {
      let, const
      function, return
      class, interface
      abstract, extends, implements
      readonly, get, set, delete
      new, this, super
      export, internal, extern
    }
    card "Control Flow" as KW_CTRL {
      if, else
      while, for
      break, continue
    }
    card "Modules" as KW_MOD {
      import, export, from, as
    }
    card "Async" as KW_ASYNC {
      async, await
    }
    card "Literals" as KW_LIT {
      true, false, null
    }
    card "Reserved (lexed, not parsed)" as KW_RES {
      try, catch, finally, throw
    }
  }
}

package "Declaration Modifiers" as MOD #E8F5E9 {
  card Modifiers {
    **export** — public module symbol
    **internal** — package-private
    **abstract** — class/method/property
    **readonly** — property immutability
    **async** — async function
    **const** / **let** — variable binding
    **extends** / **implements** — inheritance
    **get** / **set** / **delete** — property accessors
    **extern** — intrinsic function binding
  }
}

package "Decorators" as DEC #F3E5F5 {
  card CompileDecorator {
    @compile("interpreter")
    @compile("bytecode")
    @compile("AOT")
    --
    Applies to:
    • function / async function
    • compile block { ... }
  }
  card IntrinsicDecorator {
    @intrinsic("syscall.name")
    extern function foo(...)
    --
    Binds to runtime IntrinsicsRegistry
    Dispatched as INTRINSIC_SYSCALL in VM
  }
}

package "Module Syntax" as MSYN #E0F7FA {
  card ImportSyntax {
    import { sym1, sym2 } from "@scope/module";
    import { sym } from "./relative/path";
  }
  card ExportSyntax {
    export function foo() { }
    export class Bar { }
    export let x = 1;
    export { sym1, sym2 } from "other/module";
  }
}

note bottom of KW_RES
  try/catch/finally/throw are tokenized
  but have no parser/AST support yet
end note

@enduml
