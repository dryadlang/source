@startuml
!pragma layout smetana dryad_03_ast
title Dryad Language — Abstract Syntax Tree (AST)
skinparam backgroundColor #FEFEFE
skinparam shadowing false
skinparam classAttributeIconSize 0
skinparam defaultFontSize 10

abstract class ASTNode {
  + type: ASTNodeType
  + location: SourceLocation
}

abstract class Expression
abstract class Statement

class Program {
  + statements: Statement array
}

' --- Literals ---
class IntegerLiteral {
  + value: int64
}
class FloatLiteral {
  + value: double
}
class StringLiteral {
  + value: string
}
class BooleanLiteral {
  + value: bool
}
class NullLiteral

' --- Expressions ---
class Identifier {
  + name: string
}
class BinaryExpression {
  + op, left, right
}
class UnaryExpression {
  + op, operand
}
class AssignmentExpression {
  + name, value
}
class CallExpression {
  + callee, args array
}
class MemberExpression {
  + object, property, computed
}
class ArrayExpression {
  + elements array
}
class NewExpression {
  + class_name, args array
}
class FunctionExpression {
  + params, body
}
class ThisExpression
class SuperExpression
class AwaitExpression {
  + expression
}
class ErrorExpression {
  + message
}
' --- Declarations ---
class VariableDeclaration {
  + name, initializer, is_const
}
class FunctionDeclaration {
  + name, params, body
  + is_async, is_exported, is_internal
  + compile_mode: ExecutionMode
}
class ClassDeclaration {
  + name, super_class, interfaces
  + methods array, properties array
  + is_abstract, is_exported, is_internal
}
class InterfaceDeclaration {
  + name, methods array, properties array
}
class IntrinsicDeclaration {
  + intrinsic_name, function_name
  + params array, return_type
}

' --- Statements ---
class BlockStatement {
  + statements array
}
class ExpressionStatement {
  + expression
}
class ReturnStatement {
  + value
}
class IfStatement {
  + condition, then, else
}
class WhileStatement {
  + condition, body
}
class ForStatement {
  + init, condition, update, body
}
class BreakStatement
class ContinueStatement
class CompileBlockStatement {
  + mode: ExecutionMode, body
}
' --- Modules ---
class ImportDeclaration {
  + symbols array, module_path
}
class ExportFromDeclaration {
  + symbols array, module_path
}
' --- Supporting structs ---
class Parameter {
  + name, type_annotation, default_value
}
class MethodDeclaration {
  + name, params, body
  + is_constructor, is_abstract
  + is_getter, is_setter
}
class PropertyDeclaration {
  + name, type_annotation
  + is_readonly, is_abstract
  + getter_body, setter_body
}

ASTNode <|-- Expression
ASTNode <|-- Statement
ASTNode <|-- Program

Expression <|-- IntegerLiteral
Expression <|-- FloatLiteral
Expression <|-- StringLiteral
Expression <|-- BooleanLiteral
Expression <|-- NullLiteral
Expression <|-- Identifier
Expression <|-- BinaryExpression
Expression <|-- UnaryExpression
Expression <|-- AssignmentExpression
Expression <|-- CallExpression
Expression <|-- MemberExpression
Expression <|-- ArrayExpression
Expression <|-- NewExpression
Expression <|-- FunctionExpression
Expression <|-- ThisExpression
Expression <|-- SuperExpression
Expression <|-- AwaitExpression
Expression <|-- ErrorExpression

Statement <|-- VariableDeclaration
Statement <|-- FunctionDeclaration
Statement <|-- ClassDeclaration
Statement <|-- InterfaceDeclaration
Statement <|-- IntrinsicDeclaration
Statement <|-- BlockStatement
Statement <|-- ExpressionStatement
Statement <|-- ReturnStatement
Statement <|-- IfStatement
Statement <|-- WhileStatement
Statement <|-- ForStatement
Statement <|-- BreakStatement
Statement <|-- ContinueStatement
Statement <|-- CompileBlockStatement
Statement <|-- ImportDeclaration
Statement <|-- ExportFromDeclaration

ClassDeclaration *-- MethodDeclaration
ClassDeclaration *-- PropertyDeclaration
FunctionDeclaration *-- Parameter
MethodDeclaration *-- Parameter

note as N1
  **ASTNodeType enum (33 values)**
  Program, literals (5), expressions (14),
  declarations (5), statements (9), modules (2)
end note

note as N2
  **Parser notes**
  • arr[i] → MemberExpression(computed=true)
  • IndexExpression / ObjectExpression: enum only
  • Script entry: __dryad_main synthesized for top-level code
end note

@enduml
