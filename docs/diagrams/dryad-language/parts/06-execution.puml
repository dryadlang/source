@startuml
!pragma layout smetana dryad_06_execution
title Dryad Language — Triple Execution Model
skinparam backgroundColor #FEFEFE
skinparam shadowing false
skinparam defaultFontSize 10

enum ExecutionMode {
  Inherit
  Interpreter
  Bytecode
  AOT
}

class ExecutionEngine {
  - default_mode_: ExecutionMode
  - program_cache_: map<Program*, CompiledProgram>
  --
  + execute_program(Program*)
  + invoke_function(DryadFunction*, args)
  + effective_mode(decl): ExecutionMode
  + push_scope_mode() / pop_scope_mode()
}

class Interpreter {
  + global_env: Environment
  + module_loader: ModuleLoader
  + type_profiler: TypeProfiler
  + execution_engine: ExecutionEngine
  + ExpressionEvaluator
  + StatementExecutor
}

class VM {
  - stack_, slots_, frames_
  + dispatch_opcode(Opcode)
  + handle_intrinsic_syscall(id)
  + VmRuntimeDelegate
  + VmJitDelegate (optional)
}

class NativeModule {
  + load(.so path)
  + invoke(symbol, args)
  + fallback: .dryadc → live bytecode
}

class JitCompiler {
  + threshold: 1000 back-edges
  + compile_loop() → native JitLoopFn
}

ExecutionEngine --> ExecutionMode
ExecutionEngine --> Interpreter
ExecutionEngine --> VM
ExecutionEngine --> NativeModule
VM --> JitCompiler

note as N_MODE
  **Mode selection (priority)**
  1. @compile("mode") on function/block
  2. CompileBlockStatement scope
  3. ExecutionEngine::default_mode_
  --
  Async functions → always Interpreter
end note

note as N_SCRIPT
  **Script-only programs (no user functions)**
  Top-level statements → __dryad_main
  VM runs __dryad_main directly
  Top-level let bindings NOT in global_env
end note

package "invoke_function() dispatch" as DISPATCH #FFF3E0 {
  card InterpreterPath [
    DryadFunction::call_interpreted()
    ExpressionEvaluator + StatementExecutor
  ]
  card BytecodePath [
    VM::execute()
    via invoke_bytecode_program()
  ]
  card AOTPath [
    NativeModule::invoke()
    → fallback .dryadc
    → fallback live bytecode compile
  ]
}

ExecutionEngine ..> DISPATCH

@enduml
