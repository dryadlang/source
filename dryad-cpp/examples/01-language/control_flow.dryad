// Control flow: if/else, while, for-in over arrays.
// Run: dryad examples/01-language/control_flow.dryad

let score = 85;
let grade = "";
if (score >= 90) {
    grade = "A";
} else if (score >= 70) {
    grade = "B";
} else {
    grade = "C";
}
print("grade");
print(grade);

let sum = 0;
let i = 1;
while (i <= 5) {
    sum = sum + i;
    i = i + 1;
}
print("sum 1..5");
print(sum);

let items = [10, 20, 30];
let total = 0;
let idx = 0;
while (idx < 3) {
    total = total + items[idx];
    idx = idx + 1;
}
print("array total");
print(total);
