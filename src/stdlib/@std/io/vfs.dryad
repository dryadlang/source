// @std/io/vfs.dryad
// Virtual File System interface and implementations
//
// The VFS provides an abstraction layer over different filesystem backends.
// Users write against the VFS interface, and the underlying backend can be
// swapped (real filesystem vs. in-memory for testing).

import {
    ArgumentNullException,
    ArgumentException,
    ObjectDisposedException,
    FileNotFoundException,
    IOException
} from "@std/core/exceptions";

import { ValidatePath, NormalizePath } from "@std/io/io_errors";

// ============================================================================
// Backend Protocol Definition
// ============================================================================

// FileSystemBackend protocol - all backends implement these methods:
// - readFile(path: string): string
// - writeFile(path: string, content: string): void
// - listDirectory(path: string): array of strings
// - removeFile(path: string): void
// - exists(path: string): boolean
// - mkdir(path: string): void
// - dispose(): void

function FileSystemBackend() {
    return "FileSystemBackend protocol";
}

// ============================================================================
// VFS Class - Routes operations to selected backend
// ============================================================================

// VFS constructor: Creates a VFS instance with specified backend
// Parameters:
//   backend - FileSystemBackend implementation (MemoryBackend or NativeBackend)
// Returns:
//   vfs object with backend reference and disposed flag
function VFS(backend) {
    let vfs = __runtime_create_object();
    __runtime_object_set(vfs, "backend", backend);
    __runtime_object_set(vfs, "disposed", false);
    return vfs;
}

// VFS_ReadFile - Read entire file content as string
function VFS_ReadFile(vfs, path) {
    if (vfs == null) {
        return ArgumentNullException("vfs");
    }
    
    let disposed = __runtime_object_get(vfs, "disposed");
    if (disposed) {
        return ObjectDisposedException("VFS");
    }
    
    if (path == null || path == "") {
        return ArgumentException("Path cannot be null or empty");
    }
    
    let backend = __runtime_object_get(vfs, "backend");
    return _FileSystemBackend_readFile(backend, path);
}

// VFS_WriteFile - Write content to file
function VFS_WriteFile(vfs, path, content) {
    if (vfs == null) {
        return ArgumentNullException("vfs");
    }
    
    let disposed = __runtime_object_get(vfs, "disposed");
    if (disposed) {
        return ObjectDisposedException("VFS");
    }
    
    if (path == null || path == "") {
        return ArgumentException("Path cannot be null or empty");
    }
    
    if (content == null) {
        content = "";
    }
    
    let backend = __runtime_object_get(vfs, "backend");
    return _FileSystemBackend_writeFile(backend, path, content);
}

// VFS_ListDirectory - List files in directory
function VFS_ListDirectory(vfs, path) {
    if (vfs == null) {
        return ArgumentNullException("vfs");
    }
    
    let disposed = __runtime_object_get(vfs, "disposed");
    if (disposed) {
        return ObjectDisposedException("VFS");
    }
    
    if (path == null || path == "") {
        path = "/";
    }
    
    let backend = __runtime_object_get(vfs, "backend");
    return _FileSystemBackend_listDirectory(backend, path);
}

// VFS_RemoveFile - Delete file
function VFS_RemoveFile(vfs, path) {
    if (vfs == null) {
        return ArgumentNullException("vfs");
    }
    
    let disposed = __runtime_object_get(vfs, "disposed");
    if (disposed) {
        return ObjectDisposedException("VFS");
    }
    
    if (path == null || path == "") {
        return ArgumentException("Path cannot be null or empty");
    }
    
    let backend = __runtime_object_get(vfs, "backend");
    return _FileSystemBackend_removeFile(backend, path);
}

// VFS_Exists - Check if file exists
function VFS_Exists(vfs, path) {
    if (vfs == null) {
        return ArgumentNullException("vfs");
    }
    
    let disposed = __runtime_object_get(vfs, "disposed");
    if (disposed) {
        return false;
    }
    
    if (path == null || path == "") {
        return false;
    }
    
    let backend = __runtime_object_get(vfs, "backend");
    return _FileSystemBackend_exists(backend, path);
}

// VFS_Mkdir - Create directory
function VFS_Mkdir(vfs, path) {
    if (vfs == null) {
        return ArgumentNullException("vfs");
    }
    
    let disposed = __runtime_object_get(vfs, "disposed");
    if (disposed) {
        return ObjectDisposedException("VFS");
    }
    
    if (path == null || path == "") {
        return ArgumentException("Path cannot be null or empty");
    }
    
    let backend = __runtime_object_get(vfs, "backend");
    return _FileSystemBackend_mkdir(backend, path);
}

// VFS_Dispose - Clean up VFS resources
function VFS_Dispose(vfs) {
    if (vfs == null) {
        return null;
    }
    
    let disposed = __runtime_object_get(vfs, "disposed");
    if (disposed) {
        return null;
    }
    
    __runtime_object_set(vfs, "disposed", true);
    let backend = __runtime_object_get(vfs, "backend");
    if (backend != null) {
        _FileSystemBackend_dispose(backend);
    }
    return null;
}

// ============================================================================
// Backend Dispatch Functions
// ============================================================================
// These functions route to the appropriate backend implementation

function _FileSystemBackend_readFile(backend, path) {
    if (backend == null) {
        return ArgumentNullException("backend");
    }

    let pathErr = ValidatePath(path);
    if (pathErr != null) {
        return pathErr;
    }

    let normalizedPath = NormalizePath(path);
    let type = __runtime_object_get(backend, "type");
    
    if (type == "memory") {
        return _MemoryBackend_readFile(backend, normalizedPath);
    } else if (type == "native") {
        return _NativeBackend_readFile(backend, normalizedPath);
    }
    
    return IOException("Unknown backend type: " + type);
}

function _FileSystemBackend_writeFile(backend, path, content) {
    if (backend == null) {
        return ArgumentNullException("backend");
    }

    let pathErr = ValidatePath(path);
    if (pathErr != null) {
        return pathErr;
    }

    let normalizedPath = NormalizePath(path);
    let type = __runtime_object_get(backend, "type");
    
    if (type == "memory") {
        return _MemoryBackend_writeFile(backend, normalizedPath, content);
    } else if (type == "native") {
        return _NativeBackend_writeFile(backend, normalizedPath, content);
    }
    
    return IOException("Unknown backend type: " + type);
}

function _FileSystemBackend_exists(backend, path) {
    if (backend == null) {
        return false;
    }

    if (ValidatePath(path) != null) {
        return false;
    }

    let normalizedPath = NormalizePath(path);
    let type = __runtime_object_get(backend, "type");
    
    if (type == "memory") {
        return _MemoryBackend_exists(backend, normalizedPath);
    } else if (type == "native") {
        return _NativeBackend_exists(backend, normalizedPath);
    }
    
    return false;
}

function _FileSystemBackend_removeFile(backend, path) {
    if (backend == null) {
        return ArgumentNullException("backend");
    }

    let pathErr = ValidatePath(path);
    if (pathErr != null) {
        return pathErr;
    }

    let normalizedPath = NormalizePath(path);
    let type = __runtime_object_get(backend, "type");
    
    if (type == "memory") {
        return _MemoryBackend_removeFile(backend, normalizedPath);
    } else if (type == "native") {
        return _NativeBackend_removeFile(backend, normalizedPath);
    }
    
    return IOException("Unknown backend type: " + type);
}

function _FileSystemBackend_listDirectory(backend, path) {
    if (backend == null) {
        return [];
    }

    if (path == null || path == "") {
        path = "/";
    }
    if (ValidatePath(path) != null) {
        return [];
    }

    let normalizedPath = NormalizePath(path);
    let type = __runtime_object_get(backend, "type");
    
    if (type == "memory") {
        return _MemoryBackend_listDirectory(backend, normalizedPath);
    } else if (type == "native") {
        return _NativeBackend_listDirectory(backend, normalizedPath);
    }
    
    return [];
}

function _FileSystemBackend_mkdir(backend, path) {
    if (backend == null) {
        return ArgumentNullException("backend");
    }

    let pathErr = ValidatePath(path);
    if (pathErr != null) {
        return pathErr;
    }

    let normalizedPath = NormalizePath(path);
    let type = __runtime_object_get(backend, "type");
    
    if (type == "memory") {
        return _MemoryBackend_mkdir(backend, normalizedPath);
    } else if (type == "native") {
        return _NativeBackend_mkdir(backend, normalizedPath);
    }
    
    return IOException("Unknown backend type: " + type);
}

function _FileSystemBackend_dispose(backend) {
    if (backend == null) {
        return null;
    }
    
    let type = __runtime_object_get(backend, "type");
    
    if (type == "memory") {
        return _MemoryBackend_dispose(backend);
    } else if (type == "native") {
        return _NativeBackend_dispose(backend);
    }
    
    return null;
}

// ============================================================================
// MemoryBackend - In-memory filesystem for testing
// ============================================================================
// Stores files in a key-value map: path -> content
// No actual filesystem I/O, useful for testing and development

function MemoryBackend() {
    let backend = __runtime_create_object();
    __runtime_object_set(backend, "type", "memory");
    __runtime_object_set(backend, "files", __runtime_create_object());
    __runtime_object_set(backend, "disposed", false);
    return backend;
}

// _MemoryBackend_readFile - Read file from memory storage
function _MemoryBackend_readFile(backend, path) {
    if (path == null || path == "") {
        return FileNotFoundException("Invalid path");
    }
    
    let disposed = __runtime_object_get(backend, "disposed");
    if (disposed) {
        return ObjectDisposedException("MemoryBackend");
    }
    
    let files = __runtime_object_get(backend, "files");
    let content = __runtime_object_get(files, path);
    
    if (content == null) {
        return FileNotFoundException("File not found: " + path);
    }
    
    return content;
}

// _MemoryBackend_writeFile - Write file to memory storage
function _MemoryBackend_writeFile(backend, path, content) {
    if (path == null || path == "") {
        return ArgumentException("Path cannot be empty");
    }
    
    let disposed = __runtime_object_get(backend, "disposed");
    if (disposed) {
        return ObjectDisposedException("MemoryBackend");
    }
    
    let files = __runtime_object_get(backend, "files");
    __runtime_object_set(files, path, content);
    return null;
}

// _MemoryBackend_exists - Check if file exists in memory storage
function _MemoryBackend_exists(backend, path) {
    if (path == null || path == "") {
        return false;
    }
    
    let disposed = __runtime_object_get(backend, "disposed");
    if (disposed) {
        return false;
    }
    
    let files = __runtime_object_get(backend, "files");
    let content = __runtime_object_get(files, path);
    
    return content != null;
}

// _MemoryBackend_removeFile - Delete file from memory storage
function _MemoryBackend_removeFile(backend, path) {
    if (path == null || path == "") {
        return ArgumentException("Path cannot be empty");
    }
    
    let disposed = __runtime_object_get(backend, "disposed");
    if (disposed) {
        return ObjectDisposedException("MemoryBackend");
    }
    
    let files = __runtime_object_get(backend, "files");
    let exists = __runtime_object_get(files, path);
    
    if (exists == null) {
        return FileNotFoundException("File not found: " + path);
    }
    
    __runtime_object_set(files, path, null);
    return null;
}

// _MemoryBackend_listDirectory - List files under path
function _MemoryBackend_listDirectory(backend, path) {
    if (path == null || path == "") {
        path = "/";
    }
    
    let disposed = __runtime_object_get(backend, "disposed");
    if (disposed) {
        return [];
    }
    
    let files = __runtime_object_get(backend, "files");
    let keys = __runtime_object_keys(files);
    let result = [];
    let i = 0;
    let n = __runtime_array_length(keys);
    while (i < n) {
        let key = keys[i];
        let keep = false;
        if (path == "/") {
            keep = true;
        } else {
            if (key == path) {
                keep = true;
            } else {
                keep = __string_starts_with(key, path + "/");
            }
        }
        if (keep) {
            if (__runtime_object_get(files, key) != null) {
                __runtime_array_push(result, key);
            }
        }
        i = i + 1;
    }
    
    return result;
}

// _MemoryBackend_mkdir - Create directory (no-op for in-memory backend)
function _MemoryBackend_mkdir(backend, path) {
    if (path == null || path == "") {
        return ArgumentException("Path cannot be empty");
    }
    
    let disposed = __runtime_object_get(backend, "disposed");
    if (disposed) {
        return ObjectDisposedException("MemoryBackend");
    }
    
    // In-memory backend doesn't need explicit directory creation
    // Files are stored flat with full paths
    return null;
}

// _MemoryBackend_dispose - Clean up memory backend resources
function _MemoryBackend_dispose(backend) {
    if (backend == null) {
        return null;
    }
    
    let disposed = __runtime_object_get(backend, "disposed");
    if (disposed) {
        return null;
    }
    
    __runtime_object_set(backend, "disposed", true);
    __runtime_object_set(backend, "files", null);
    return null;
}

// ============================================================================
// NativeBackend - OS filesystem operations
// ============================================================================
// Wraps platform filesystem syscalls (__open_read/write, __read, __write, ...)

function NativeBackend() {
    let backend = __runtime_create_object();
    __runtime_object_set(backend, "type", "native");
    __runtime_object_set(backend, "disposed", false);
    return backend;
}

// _NativeBackend_readFile - Read from real filesystem
function _NativeBackend_readFile(backend, path) {
    if (path == null || path == "") {
        return FileNotFoundException("Invalid path");
    }
    
    let disposed = __runtime_object_get(backend, "disposed");
    if (disposed) {
        return ObjectDisposedException("NativeBackend");
    }

    let size = __filesize(path);
    if (size < 0) {
        return FileNotFoundException("File not found: " + path);
    }

    let fd = __open_read(path);
    if (fd < 0) {
        return FileNotFoundException("File not found: " + path);
    }

    let content = "";
    if (size > 0) {
        content = __read(fd, size);
        if (__runtime_value_kind(content) != "string") {
            __close(fd);
            return IOException("Failed to read file: " + path);
        }
    }
    __close(fd);
    return content;
}

// _NativeBackend_writeFile - Write to real filesystem
function _NativeBackend_writeFile(backend, path, content) {
    if (path == null || path == "") {
        return ArgumentException("Path cannot be empty");
    }
    
    let disposed = __runtime_object_get(backend, "disposed");
    if (disposed) {
        return ObjectDisposedException("NativeBackend");
    }

    let fd = __open_write(path);
    if (fd < 0) {
        return IOException("Failed to open file for writing: " + path);
    }

    let written = __write(fd, content);
    __close(fd);
    if (written != __string_length(content)) {
        return IOException("Failed to write file: " + path);
    }
    return null;
}

// _NativeBackend_exists - Check if file exists on real filesystem
function _NativeBackend_exists(backend, path) {
    if (path == null || path == "") {
        return false;
    }
    
    let disposed = __runtime_object_get(backend, "disposed");
    if (disposed) {
        return false;
    }

    return __exists(path);
}

// _NativeBackend_removeFile - Delete from real filesystem
function _NativeBackend_removeFile(backend, path) {
    if (path == null || path == "") {
        return ArgumentException("Path cannot be empty");
    }
    
    let disposed = __runtime_object_get(backend, "disposed");
    if (disposed) {
        return ObjectDisposedException("NativeBackend");
    }

    if (!__exists(path)) {
        return FileNotFoundException("File not found: " + path);
    }

    let result = __unlink(path);
    if (result < 0) {
        return IOException("Failed to remove file: " + path);
    }
    return null;
}

// _NativeBackend_listDirectory - List files on real filesystem
function _NativeBackend_listDirectory(backend, path) {
    if (path == null || path == "") {
        path = ".";
    }
    
    let disposed = __runtime_object_get(backend, "disposed");
    if (disposed) {
        return [];
    }

    return __readdir(path);
}

// _NativeBackend_mkdir - Create directory on real filesystem
function _NativeBackend_mkdir(backend, path) {
    if (path == null || path == "") {
        return ArgumentException("Path cannot be empty");
    }
    
    let disposed = __runtime_object_get(backend, "disposed");
    if (disposed) {
        return ObjectDisposedException("NativeBackend");
    }

    let result = __mkdir(path);
    if (result < 0) {
        return IOException("Failed to create directory: " + path);
    }
    return null;
}

// _NativeBackend_dispose - Clean up native backend resources
function _NativeBackend_dispose(backend) {
    if (backend == null) {
        return null;
    }
    
    let disposed = __runtime_object_get(backend, "disposed");
    if (disposed) {
        return null;
    }
    
    __runtime_object_set(backend, "disposed", true);
    return null;
}

// Deprecated pre-convention names, kept so existing code keeps working.
// They will be removed in a future release; use the names on the right.
// @deprecated Use VFS_Dispose.
let VFS_dispose = VFS_Dispose;
// @deprecated Use VFS_Exists.
let VFS_exists = VFS_Exists;
// @deprecated Use VFS_ListDirectory.
let VFS_listDirectory = VFS_ListDirectory;
// @deprecated Use VFS_Mkdir.
let VFS_mkdir = VFS_Mkdir;
// @deprecated Use VFS_ReadFile.
let VFS_readFile = VFS_ReadFile;
// @deprecated Use VFS_RemoveFile.
let VFS_removeFile = VFS_RemoveFile;
// @deprecated Use VFS_WriteFile.
let VFS_writeFile = VFS_WriteFile;
