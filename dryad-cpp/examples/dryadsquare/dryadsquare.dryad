// DryadSquare — Turing-completeness benchmark (100% Dryad).
// Run from dryad-cpp/: ./build/bin/dryad examples/dryadsquare/dryadsquare.dryad

import { Sq_runAndGet } from "examples/dryadsquare/square/runtime";

print("DryadSquare Turing benchmark");
print("==========================");

let sumProgram = "var n = 10; var i = 0; var sum = 0; while (i < n) { sum = sum + i; i = i + 1; }";
let sum = Sq_runAndGet(sumProgram, "sum");
print("sum_0_9");
print(sum);

let mulProgram = "var a = 7; var b = 6; var result = 0; var i = 0; while (i < b) { result = result + a; i = i + 1; }";
let product = Sq_runAndGet(mulProgram, "result");
print("mul_7_6");
print(product);

let collatzProgram = "var n = 27; var steps = 0; while (n != 1) { if (n % 2 == 0) { n = n / 2; } else { n = n * 3 + 1; } steps = steps + 1; }";
let steps = Sq_runAndGet(collatzProgram, "steps");
print("collatz_27_steps");
print(steps);

let triProgram = "var n = 20; var i = 0; var total = 0; while (i <= n) { var j = 0; var inner = 0; while (j < i) { inner = inner + 1; j = j + 1; } total = total + inner; i = i + 1; }";
let tri = Sq_runAndGet(triProgram, "total");
print("triangular_20");
print(tri);

let passed = 0;
let failed = 0;

if (sum == 45) { passed = passed + 1; } else { failed = failed + 1; print("FAIL sum"); }
if (product == 42) { passed = passed + 1; } else { failed = failed + 1; print("FAIL mul"); }
if (steps == 111) { passed = passed + 1; } else { failed = failed + 1; print("FAIL collatz"); }
if (tri == 210) { passed = passed + 1; } else { failed = failed + 1; print("FAIL tri"); }

print("tests_passed");
print(passed);
print("tests_failed");
print(failed);

if (failed == 0) {
    print("TURING_BENCHMARK_OK");
}
