}

function Promise_reject(error) {
    return new Promise(function(resolve, reject) {
        reject(error);
        return null;
    });
}

function Promise_wrap(promise) {
    return new Promise(function(resolve, reject) {
        if (promise._state == "fulfilled") {
            resolve(promise._value);
            return null;
        }
        if (promise._state == "rejected") {
            reject(promise._error);
            return null;
        }
        promise.then(function(value) {
            resolve(value);
            return value;
        }, function(error) {
            reject(error);
            return error;
        });
        return null;
    });
}

function Promise_all(promises) {
    return new Promise(function(resolve, reject) {
        let remaining = __runtime_array_length(promises);
        if (remaining == 0) {
            resolve([]);
