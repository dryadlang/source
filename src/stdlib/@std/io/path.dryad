// @std/io/path.dryad
// Path manipulation utilities

import { ArgumentException, IOException } from "@std/core/exceptions";

function _Path_charAt(path, index) {
    let len = __string_length(path);
    if (index < 0 || index >= len) {
        return "";
    }
    let handle = __alloc_bytes(len);
    __string_to_bytes(path, handle, 0);
    let ch = __bytes_to_string(handle, index, 1);
    __free_bytes(handle);
    return ch;
}

function _Path_isSeparator(byte) {
    return byte == 47 || byte == 92;
}

function _Path_pop(parts) {
    let next = [];
    let n = __runtime_array_length(parts);
    let i = 0;
    while (i < n - 1) {
        __runtime_array_push(next, parts[i]);
        i = i + 1;
    }
    return next;
}

function _Path_joinParts(absolute, parts) {
    let n = __runtime_array_length(parts);
    if (n == 0) {
        if (absolute) {
            return "/";
        }
        return ".";
    }

    let out = "";
    if (absolute) {
        out = "/";
    }
    let i = 0;
    while (i < n) {
        if (i > 0) {
            out = out + "/";
        }
        out = out + parts[i];
        i = i + 1;
    }
    return out;
}

// Lexical clean: swap separators, drop "." and empty segments, apply "..".
// Returns null when the path contains a 0 byte (that byte would truncate a syscall).
function _Path_normalize(path) {
    if (path == null) {
        return null;
    }
    let len = __string_length(path);
    if (len == 0) {
        return "";
    }

    let raw = __alloc_bytes(len);
    __string_to_bytes(path, raw, 0);

    let i = 0;
    while (i < len) {
        if (__buffer_get(raw, i) == 0) {
            __free_bytes(raw);
            return null;
        }
        i = i + 1;
    }

    let absolute = _Path_isSeparator(__buffer_get(raw, 0));
    let parts = [];
    let start = 0;
    i = 0;
    while (i <= len) {
        let atEnd = i == len;
        let sep = false;
        if (!atEnd) {
            sep = _Path_isSeparator(__buffer_get(raw, i));
        }
        if (atEnd || sep) {
            let segLen = i - start;
            if (segLen > 0) {
                let seg = __bytes_to_string(raw, start, segLen);
                if (seg == "..") {
                    let count = __runtime_array_length(parts);
                    if (count > 0) {
                        parts = _Path_pop(parts);
                    } else {
                        if (!absolute) {
                            __runtime_array_push(parts, seg);
                        }
                    }
                } else {
                    if (seg != ".") {
                        __runtime_array_push(parts, seg);
                    }
                }
            }
            start = i + 1;
        }
        i = i + 1;
    }
    __free_bytes(raw);
    return _Path_joinParts(absolute, parts);
}

function Path_Join(a, b) {
    if (a == null || a == "") {
        return ArgumentException("Path segment cannot be empty");
    }
    if (_Path_normalize(a) == null) {
        return ArgumentException("Path contains a null byte");
    }
    if (b == null || b == "") {
        return _Path_normalize(a);
    }
    if (_Path_normalize(b) == null) {
        return ArgumentException("Path contains a null byte");
    }
    let bNorm = _Path_normalize(b);
    if (__string_length(bNorm) > 0 && _Path_charAt(bNorm, 0) == "/") {
        return bNorm;
    }
    return _Path_normalize(a + "/" + b);
}

function Path_Dirname(path) {
    if (path == null || path == "") {
        return ".";
    }
    path = _Path_normalize(path);
    if (path == null || path == "") {
        return ".";
    }
    let len = __string_length(path);

    let i = len - 1;
    while (i >= 0) {
        let ch = _Path_charAt(path, i);
        if (ch == "/") {
            if (i == 0) {
                return "/";
            }
            let handle = __alloc_bytes(len);
            __string_to_bytes(path, handle, 0);
            let dir = __bytes_to_string(handle, 0, i);
            __free_bytes(handle);
            return dir;
        }
        i = i - 1;
    }
    return ".";
}

function Path_Basename(path) {
    if (path == null || path == "") {
        return "";
    }
    path = _Path_normalize(path);
    if (path == null || path == "") {
        return "";
    }
    let len = __string_length(path);

    let i = len - 1;
    while (i >= 0) {
        let ch = _Path_charAt(path, i);
        if (ch == "/") {
            let nameLen = len - i - 1;
            if (nameLen <= 0) {
                return "";
            }
            let fullHandle = __alloc_bytes(len);
            __string_to_bytes(path, fullHandle, 0);
            let name = __bytes_to_string(fullHandle, i + 1, nameLen);
            __free_bytes(fullHandle);
            return name;
        }
        i = i - 1;
    }
    return path;
}

function Path_Extension(path) {
    let name = Path_Basename(path);
    let len = __string_length(name);
    if (len == 0) {
        return "";
    }

    let i = len - 1;
    while (i >= 0) {
        let ch = _Path_charAt(name, i);
        if (ch == ".") {
            if (i == 0) {
                return "";
            }
            let nameHandle = __alloc_bytes(len);
            __string_to_bytes(name, nameHandle, 0);
            let ext = __bytes_to_string(nameHandle, i, len - i);
            __free_bytes(nameHandle);
            return ext;
        }
        i = i - 1;
    }
    return "";
}

function Path_EnsureDirectory(path) {
    if (path == null || path == "") {
        return ArgumentException("Path cannot be null or empty");
    }

    path = _Path_normalize(path);
    if (path == null) {
        return ArgumentException("Path contains a null byte");
    }
    if (path == "." || path == "/") {
        return null;
    }

    if (__exists(path)) {
        return null;
    }

    let parent = Path_Dirname(path);
    if (parent != "." && parent != path) {
        let parentErr = Path_EnsureDirectory(parent);
        if (parentErr != null) {
            return parentErr;
        }
    }

    let result = __mkdir(path);
    if (result < 0) {
        return IOException("Failed to create directory: " + path);
    }
    return null;
}

function Path_EnsureParentForFile(path) {
    if (path == null || path == "") {
        return ArgumentException("Path cannot be null or empty");
    }

    let dir = Path_Dirname(path);
    if (dir == "." || dir == "") {
        return null;
    }
    return Path_EnsureDirectory(dir);
}

function _Path_Create() {
    let path = __runtime_create_object();
    __runtime_object_set(path, "join", Path_Join);
    __runtime_object_set(path, "dirname", Path_Dirname);
    __runtime_object_set(path, "basename", Path_Basename);
    __runtime_object_set(path, "extension", Path_Extension);
    __runtime_object_set(path, "ensureDirectory", Path_EnsureDirectory);
    __runtime_object_set(path, "ensureParentForFile", Path_EnsureParentForFile);
    return path;
}

let Path = _Path_Create();

// Deprecated pre-convention names, kept so existing code keeps working.
// They will be removed in a future release; use the names on the right.
// @deprecated Use Path_Basename.
let Path_basename = Path_Basename;
// @deprecated Use Path_Dirname.
let Path_dirname = Path_Dirname;
// @deprecated Use Path_EnsureDirectory.
let Path_ensureDirectory = Path_EnsureDirectory;
// @deprecated Use Path_EnsureParentForFile.
let Path_ensureParentForFile = Path_EnsureParentForFile;
// @deprecated Use Path_Extension.
let Path_extension = Path_Extension;
// @deprecated Use Path_Join.
let Path_join = Path_Join;
