// @std/async/promise.dryad
// Promise<T> — microtask-driven settlement (Phase 5.1+)

import {
    EventLoop_Schedule,
    EventLoop_schedule
} from "@std/async/event_loop";

function _Promise_queueSettlement(promise, fulfilled, payload) {
    EventLoop_Schedule(function() {
        if (promise._state != "pending") {
            return null;
        }
        if (fulfilled) {
            promise._state = "fulfilled";
            promise._value = payload;
            _Promise_flushFulfilled(promise);
        } else {
            promise._state = "rejected";
            promise._error = payload;
            _Promise_flushRejected(promise);
        }
        return null;
    });
    return null;
}

function _Promise_isPromise(value) {
    if (value == null) {
        return false;
    }
    let kind = __runtime_value_kind(value);
    if (kind != "instance" && kind != "object") {
        return false;
    }
    return value._state != null;
}

function _Promise_createDeferred() {
    let deferred = __runtime_create_object();
    let promise = new Promise(function(resolve, reject) {
        __runtime_object_set(deferred, "resolve", resolve);
        __runtime_object_set(deferred, "reject", reject);
        return null;
    });
    __runtime_object_set(deferred, "promise", promise);
    return deferred;
}

function _Promise_adoptResolved(deferred, value) {
    if (_Promise_isPromise(value)) {
        if (value._state == "fulfilled") {
            value = value._value;
        } else if (value._state == "rejected") {
            let reject = __runtime_object_get(deferred, "reject");
            reject(value._error);
            return null;
        } else if (value._state == "pending") {
            value.then(function(v) {
                let resolve = __runtime_object_get(deferred, "resolve");
                resolve(v);
                return v;
            }, function(err) {
                let reject = __runtime_object_get(deferred, "reject");
                reject(err);
                return err;
            });
            return null;
        }
    }
    let resolve = __runtime_object_get(deferred, "resolve");
    resolve(value);
    return null;
}

function _Promise_adoptRejected(deferred, error) {
    let reject = __runtime_object_get(deferred, "reject");
    reject(error);
    return null;
}

function _Promise_flushFulfilled(promise) {
    let i = 0;
    let count = __runtime_array_length(promise._callbacks);
    while (i < count) {
        let entry = promise._callbacks[i];
        let onFulfilled = entry[0];
        let deferred = entry[2];
        if (onFulfilled != null) {
            _Promise_adoptResolved(deferred, onFulfilled(promise._value));
        } else {
            _Promise_adoptResolved(deferred, promise._value);
        }
        i = i + 1;
    }
    promise._callbacks = [];
    return null;
}

function _Promise_flushRejected(promise) {
    let i = 0;
    let count = __runtime_array_length(promise._callbacks);
    while (i < count) {
        let entry = promise._callbacks[i];
        let onRejected = entry[1];
        let deferred = entry[2];
        if (onRejected != null) {
            _Promise_adoptResolved(deferred, onRejected(promise._error));
        } else {
            _Promise_adoptRejected(deferred, promise._error);
        }
        i = i + 1;
    }
    promise._callbacks = [];
    return null;
}

class Promise {
    constructor(executor) {
        this._state = "pending";
        this._value = null;
        this._error = null;
        this._callbacks = [];

        let self = this;

        function resolve(value) {
            if (self._state != "pending") {
                return null;
            }
            _Promise_queueSettlement(self, true, value);
            return null;
        }

        function reject(error) {
            if (self._state != "pending") {
                return null;
            }
            _Promise_queueSettlement(self, false, error);
            return null;
        }

        executor(resolve, reject);
    }

    then(onFulfilled, onRejected = null) {
        if (this._state == "rejected") {
            if (onRejected != null) {
                let deferredRejected = _Promise_createDeferred();
                let err = this._error;
                EventLoop_Schedule(function() {
                    _Promise_adoptResolved(deferredRejected, onRejected(err));
                    return null;
                });
                return __runtime_object_get(deferredRejected, "promise");
            }
            return Promise_Wrap(this);
        }
        if (this._state == "fulfilled") {
            let deferred = _Promise_createDeferred();
            let val = this._value;
            EventLoop_Schedule(function() {
                if (onFulfilled != null) {
                    _Promise_adoptResolved(deferred, onFulfilled(val));
                } else {
                    _Promise_adoptResolved(deferred, val);
                }
                return null;
            });
            return __runtime_object_get(deferred, "promise");
        }

        let deferred = _Promise_createDeferred();
        __runtime_array_push(this._callbacks, [onFulfilled, onRejected, deferred]);
        return __runtime_object_get(deferred, "promise");
    }

    catch(onRejected) {
        return this.catchError(onRejected);
    }

    catchError(onRejected) {
        return this.then(null, onRejected);
    }

    finally(onFinally) {
        return this.finallyDo(onFinally);
    }

    // onFinally runs once the promise settles (not at call time) and the
    // returned promise keeps the original outcome: a rejection stays a
    // rejection with the same error.
    finallyDo(onFinally) {
        return this.then(function(value) {
            if (onFinally != null) {
                onFinally();
            }
            return value;
        }, function(error) {
            if (onFinally != null) {
                onFinally();
            }
            return Promise_Reject(error);
        });
    }
}

function Promise_Resolve(value) {
    if (_Promise_isPromise(value)) {
        if (value._state == "fulfilled") {
            return Promise_Wrap(value);
        }
        if (value._state == "rejected") {
            return Promise_Reject(value._error);
        }
        if (value._state == "pending") {
            let deferred = _Promise_createDeferred();
            value.then(function(v) {
                let resolve = __runtime_object_get(deferred, "resolve");
                resolve(v);
                return v;
            }, function(err) {
                let reject = __runtime_object_get(deferred, "reject");
                reject(err);
                return err;
            });
            return __runtime_object_get(deferred, "promise");
        }
    }
    return new Promise(function(resolve, reject) {
        resolve(value);
        return null;
    });
}

function Promise_Reject(error) {
    return new Promise(function(resolve, reject) {
        reject(error);
        return null;
    });
}

function Promise_Wrap(promise) {
    return new Promise(function(resolve, reject) {
        if (promise._state == "fulfilled") {
            resolve(promise._value);
            return null;
        }
        if (promise._state == "rejected") {
            reject(promise._error);
            return null;
        }
        promise.then(function(value) {
            resolve(value);
            return value;
        }, function(error) {
            reject(error);
            return error;
        });
        return null;
    });
}

function Promise_All(promises) {
    return new Promise(function(resolve, reject) {
        let remaining = __runtime_array_length(promises);
        if (remaining == 0) {
            resolve([]);
            return null;
        }

        let results = [];
        let i = 0;
        while (i < remaining) {
            __runtime_array_push(results, null);
            i = i + 1;
        }

        let settled = 0;
        i = 0;
        while (i < remaining) {
            let index = i;
            promises[i].then(function(value) {
                results[index] = value;
                settled = settled + 1;
                if (settled == remaining) {
                    resolve(results);
                }
                return value;
            }, function(error) {
                reject(error);
                return error;
            });
            i = i + 1;
        }
        return null;
    });
}

function Promise_Flush() {
    __runtime_event_loop_pump_all();
    return null;
}

function Promise_Await(promise) {
    return __runtime_await_promise(promise);
}

function Promise_Race(promises) {
    return new Promise(function(resolve, reject) {
        let count = __runtime_array_length(promises);
        if (count == 0) {
            reject("Promise.race: no promises");
            return null;
        }

        let settled = false;
        let i = 0;
        while (i < count) {
            let p = promises[i];
            p.then(function(value) {
                if (!settled) {
                    settled = true;
                    resolve(value);
                }
                return value;
            }, function(error) {
                if (!settled) {
                    settled = true;
                    reject(error);
                }
                return error;
            });
            i = i + 1;
        }
        return null;
    });
}

// Deprecated pre-convention names, kept so existing code keeps working.
// They will be removed in a future release; use the names on the right.
// @deprecated Use Promise_All.
let Promise_all = Promise_All;
// @deprecated Use Promise_Await.
let Promise_await = Promise_Await;
// @deprecated Use Promise_Flush.
let Promise_flush = Promise_Flush;
// @deprecated Use Promise_Race.
let Promise_race = Promise_Race;
// @deprecated Use Promise_Reject.
let Promise_reject = Promise_Reject;
// @deprecated Use Promise_Resolve.
let Promise_resolve = Promise_Resolve;
// @deprecated Use Promise_Wrap.
let Promise_wrap = Promise_Wrap;
