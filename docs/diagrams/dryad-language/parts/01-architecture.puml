@startuml
!pragma layout smetana dryad_01_architecture
title Dryad Language — Architecture Overview
skinparam backgroundColor #FEFEFE
skinparam packageStyle rectangle
skinparam shadowing false
skinparam defaultFontSize 11
skinparam ArrowColor #555555
skinparam NoteBackgroundColor #FFFDE7
skinparam NoteBorderColor #F9A825

legend top left
  |= Layer |= Responsibility |
  | **Source** | .dryad scripts, .dyd library sources |
  | **Frontend** | Lexer → Parser → AST |
  | **Analysis** | Semantic analysis, validation, import cycles |
  | **Profiling** | Interpreter observation run (TypeProfiler) |
  | **Bytecode** | BytecodeCompiler → .dryadc / VM |
  | **AOT** | Micro-IR → LLVM IR → native .so / executable |
  | **Runtime** | Values, OOP, intrinsics, event loop |
  | **Stdlib** | @std/* pure-Dryad APIs over intrinsics |
endlegend

package "Source Artifacts" as SRC #E3F2FD {
  class ".dryad\nScript source" as A_DRYAD
  class ".dyd\nLibrary source" as A_DYD
  class "dryad.toml\nPackage manifest" as A_TOML
}

package "Compiled Artifacts" as ART #E8F5E9 {
  class ".dryadc\nBytecode (magic DRYADC v2)" as A_DRYADC
  class ".dyl\nLibrary binary (magic DRYADYL v1)" as A_DYL
  class ".ll\nLLVM IR" as A_LL
  class ".so\nNative shared object" as A_SO
  class "executable\nLinked native binary" as A_EXE
}

package "Frontend" as FE #FFF3E0 {
  class "Lexer" as Lexer
  class "Parser" as Parser
  class "AST" as AST
}

package "Static Analysis" as SA #F3E5F5 {
  class "SemanticAnalyzer" as Semantic
  class "ProgramValidator" as Validator
  class "ImportCycleDetector" as CycleDet
}

package "Execution Tiers" as EXEC #E0F7FA {
  class "Interpreter\nTree-walk" as Interp
  class "BytecodeCompiler" as BCComp
  class "VM\nOpcode dispatch" as VM
  class "JitCompiler\nHot-loop JIT" as JIT
  class "AOT Compiler" as AOT
  class "NativeModule\ndlopen .so" as Native
}

package "Runtime Core" as RT #FCE4EC {
  class "Value Model" as Value
  class "Environment" as Env
  class "ModuleLoader" as ModLoad
  class "IntrinsicsRegistry" as Intrinsics
  class "EventLoop" as EvLoop
}

package "Standard Library" as STD #E8EAF6 {
  class "@std/core" as STD_CORE
  class "@std/buffers" as STD_BUF
  class "@std/collections" as STD_COLL
  class "@std/io" as STD_IO
  class "@std/async" as STD_ASYNC
  class "@std/net" as STD_NET
}

' --- Data flow ---
A_DRYAD --> Lexer
A_DYD --> Lexer
Lexer --> Parser
Parser --> AST

AST --> Semantic
AST --> Validator
AST --> CycleDet

AST --> Interp : profile run
Interp --> BCComp : TypeProfiler data
BCComp --> A_DRYADC
BCComp --> VM

A_DRYADC --> VM
A_DRYADC --> AOT
AOT --> A_LL
A_LL --> A_SO
AOT --> A_EXE

A_DYD --> A_DYL : compile --lib

VM --> Value
Interp --> Value
Native --> Value

ModLoad --> A_DYD
ModLoad --> A_DYL

Intrinsics --> STD_BUF
Intrinsics --> STD_IO
Intrinsics --> STD_NET
Intrinsics --> STD_ASYNC

STD_CORE <-- STD_COLL
STD_BUF <-- STD_IO
STD_BUF <-- STD_NET
STD_IO <-- STD_NET
STD_ASYNC <-- STD_IO
STD_ASYNC <-- STD_NET

note bottom of EXEC
  **Triple Execution Model**
  Per-function or per-block mode via @compile("interpreter"|"bytecode"|"AOT")
  Default: Interpreter
  Async functions always use interpreter path
end note

note bottom of ART
  Resolution: .dyd → .dryad (source)
  DRYAD_LIBRARY_PATH + dryad_modules/ for packages
end note

@enduml
