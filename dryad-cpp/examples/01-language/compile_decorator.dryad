// @compile decorator: bytecode VM for hot paths.
// Run: dryad examples/01-language/compile_decorator.dryad
// Run with VM default: dryad --vm examples/01-language/compile_decorator.dryad

@compile("bytecode")
function compute_sum(n) {
    let sum = 0;
    let i = 0;
    while (i < n) {
        sum = sum + i;
        i = i + 1;
    }
    return sum;
}

let result = compute_sum(10);
print("sum 0..9");
print(result);
