// @auto-test
// @allow-net
// @std/net: offline checks (no sockets opened) for the public API.

import {
    Socket_IsSocket, SocketDomain, SocketDomain_IPv4, SocketDomain_IPv6,
    SocketType, SocketType_Stream, SocketType_Datagram,
    Shutdown, Shutdown_Read, Shutdown_Write, Shutdown_Both,
    Net_ResolveHost, Net_ResolveHostOrError,
    HttpHeaders, HttpRequest, HttpResponse, HttpResponse_Parse, Http_ParseUrl,
    NetworkStream_FromSocket, TlsStream, TlsStream_IsAvailable, TlsStream_Connect
} from "@std/net";
import { Buffer_New } from "@std/buffers/buffer";

// Renders any value for failure messages (Dryad has no implicit string conversion).
function show(value) {
    let kind = __runtime_value_kind(value);
    if (kind == "string") {
        return "\"" + value + "\"";
    }
    if (kind == "integer") {
        return __int_to_string(value);
    }
    if (kind == "boolean") {
        if (value) {
            return "true";
        }
        return "false";
    }
    if (kind == "null") {
        return "null";
    }
    return "<" + kind + ">";
}

function expectEq(label, actual, expected) {
    if (actual == expected) {
        return true;
    }
    return label + ": expected " + show(expected) + ", got " + show(actual);
}

function all(checks) {
    let i = 0;
    while (i < __runtime_array_length(checks)) {
        let c = checks[i];
        let r = expectEq(c[0], c[1], c[2]);
        if (r != true) {
            return r;
        }
        i = i + 1;
    }
    return true;
}

function test_is_socket_rejects_non_sockets() {
    return all([
        ["string", Socket_IsSocket("connect failed"), false],
        ["null", Socket_IsSocket(null), false],
        ["number", Socket_IsSocket(3), false],
        ["plain object", Socket_IsSocket(SocketDomain), false]
    ]);
}

function test_constants_match_posix_values() {
    return all([
        ["AF_INET", SocketDomain_IPv4, 2],
        ["AF_INET6", SocketDomain_IPv6, 10],
        ["SOCK_STREAM", SocketType_Stream, 1],
        ["SOCK_DGRAM", SocketType_Datagram, 2],
        ["SHUT_RD", Shutdown_Read, 0],
        ["SHUT_WR", Shutdown_Write, 1],
        ["SHUT_RDWR", Shutdown_Both, 2],
        ["SocketDomain.IPv6", SocketDomain.IPv6, SocketDomain_IPv6],
        ["SocketType.Datagram", SocketType.Datagram, SocketType_Datagram],
        ["Shutdown.Both", Shutdown.Both, Shutdown_Both]
    ]);
}

function test_resolve_host_literals_without_dns() {
    let pair = Net_ResolveHostOrError("127.0.0.1", "connect");
    let bad = Net_ResolveHostOrError("", "connect");
    return all([
        ["ipv4 literal", Net_ResolveHost("10.0.0.7"), "10.0.0.7"],
        ["pair ip", pair[0], "127.0.0.1"],
        ["pair error", pair[1], null],
        ["empty ip", bad[0], null],
        ["empty error", bad[1], "connect: failed to resolve host"]
    ]);
}

function test_http_headers_and_request_defaults() {
    let headers = new HttpHeaders();
    headers.set("Content-Type", "text/plain");
    let req = new HttpRequest("GET", "http://example.test/", null, null);
    return all([
        ["header get", headers.get("Content-Type"), "text/plain"],
        ["missing header", headers.get("X-None"), null],
        ["method", req.method, "GET"],
        ["default body", req.body, ""],
        ["default headers", req.headers.get("Host"), null]
    ]);
}

function test_http_response_parse() {
    let raw = "HTTP/1.1 404 Not Found\r\nContent-Length: 2\r\n\r\nno";
    let res = HttpResponse_Parse(raw);
    let direct = new HttpResponse(200, "OK", new HttpHeaders(), "x");
    return all([
        ["status", res.statusCode, 404],
        ["text", res.statusText, "Not Found"],
        ["header", res.headers.get("Content-Length"), "2"],
        ["body", res.body, "no"],
        ["malformed", HttpResponse_Parse("HTTP/1.1 200 OK"), "Malformed HTTP response"],
        ["empty", HttpResponse_Parse(""), "Empty HTTP response"],
        ["constructor", direct.statusCode, 200]
    ]);
}

function test_http_headers_ignore_case_and_reject_injection() {
    let headers = new HttpHeaders();
    headers.set("X-Token", "a");
    headers.set("x-token", "b");
    let names = [];
    headers.forEach(function(name, value) {
        __runtime_array_push(names, name + "=" + value);
        return null;
    });
    return all([
        ["lookup ignores case", headers.get("X-TOKEN"), "b"],
        ["has ignores case", headers.has("x-Token"), true],
        ["one entry per name", __runtime_array_length(names), 1],
        ["last spelling kept", names[0], "x-token=b"],
        ["CRLF in value", headers.set("X-A", "v\r\nX-Evil: 1"), "Header value must not contain CR or LF"],
        ["LF in name", headers.set("X\nB", "v"), "Header name must not contain CR or LF"],
        ["non-string value", headers.set("X-N", 5), "Header value must be a string"],
        ["rejected not stored", headers.has("X-A"), false]
    ]);
}

function test_http_response_parse_chunked() {
    let head = "HTTP/1.1 200 OK\r\nTransfer-Encoding: Chunked\r\n\r\n";
    let ok = HttpResponse_Parse(head + "3\r\nabc\r\n2\r\nde\r\n0\r\nX-Trailer: t\r\n\r\n");
    return all([
        ["decoded", ok.body, "abcde"],
        ["truncated", HttpResponse_Parse(head + "5\r\nab"), "Malformed chunked HTTP body"],
        ["no last chunk", HttpResponse_Parse(head + "2\r\nab\r\n"), "Malformed chunked HTTP body"],
        ["bad size", HttpResponse_Parse(head + "zz\r\nab\r\n0\r\n\r\n"), "Malformed chunked HTTP body"]
    ]);
}

function test_http_parse_url() {
    let https = Http_ParseUrl("https://example.test/a/b?q=1");
    let plain = Http_ParseUrl("http://example.test:8080");
    return all([
        ["https scheme", https.scheme, "https"],
        ["https port", https.port, 443],
        ["https host", https.host, "example.test"],
        ["https path", https.path, "/a/b?q=1"],
        ["explicit port", plain.port, 8080],
        ["default path", plain.path, "/"],
        ["empty", Http_ParseUrl(""), "URL cannot be null or empty"]
    ]);
}

function test_network_stream_rejects_non_sockets() {
    return all([
        ["string", NetworkStream_FromSocket("connect failed"), "Expected a Socket"],
        ["null", NetworkStream_FromSocket(null), "Socket cannot be null"]
    ]);
}

function test_tls_connect_reports_unavailable_or_bad_fd() {
    // Runs offline: with TLS built in, a bad descriptor must be rejected before
    // the handshake (which would need network access).
    let result = TlsStream_Connect(-1, "example.test");
    if (TlsStream_IsAvailable()) {
        return expectEq("bad fd", result, "TlsStream_Connect requires an open socket descriptor");
    }
    return expectEq("unavailable", result, "TLS is not available in this build");
}

function test_tls_stream_closed_or_invalid_session_rejects_io() {
    // A handle of -1 means "no session": every Stream trait getter must
    // report accordingly, and read/write must fail without touching the
    // (here, deliberately absent) buffer argument.
    let invalid = new TlsStream(-1, "example.test");
    return all([
        ["not readable", invalid.canRead, false],
        ["not writable", invalid.canWrite, false],
        ["not seekable", invalid.canSeek, false],
        ["length unsupported", invalid.length, "TlsStream does not support length"],
        ["position unsupported", invalid.position, "TlsStream is not seekable"],
        ["seek unsupported", invalid.seek(0, 0), "TlsStream is not seekable"],
        ["flush is a no-op", invalid.flush(), null],
        ["read on invalid session", invalid.read(null, 0, 0), "Invalid TLS session"],
        ["write on invalid session", invalid.write(null, 0, 0), "Invalid TLS session"],
        // close() on an already-"closed" (negative handle) session is a no-op,
        // not an error, and stays idempotent.
        ["close is a no-op", invalid.close(), null]
    ]);
}

function test_tls_stream_direct_construction_and_close() {
    if (!TlsStream_IsAvailable()) {
        return true;
    }
    // A handle that was never produced by a real handshake: the session
    // lookup intrinsics (tls_send_buffer/tls_recv_buffer/tls_close) all treat
    // an unknown handle as "not found" rather than crashing, so this
    // exercises the full TlsStream surface without a real TLS connection.
    let stream = new TlsStream(999999, "example.test");
    let buf = Buffer_New(4);
    let result = all([
        ["readable while open", stream.canRead, true],
        ["writable while open", stream.canWrite, true],
        ["not seekable", stream.canSeek, false],
        ["read on unknown session fails", stream.read(buf, 0, 4), "TLS read failed"],
        ["write on unknown session fails", stream.write(buf, 0, 4), "TLS write failed"]
    ]);
    if (result != true) {
        return result;
    }

    stream.close();
    return all([
        ["closed after close()", stream.canRead, false],
        ["read after close", stream.read(buf, 0, 4), "TlsStream is closed"],
        ["write after close", stream.write(buf, 0, 4), "TlsStream is closed"],
        ["close is idempotent", stream.close(), null]
    ]);
}
