        if (value._state == "pending") {
            let deferred = Promise_createDeferred();
            value.then(function(v) {
                let resolve = __runtime_object_get(deferred, "resolve");
                resolve(v);
                return v;
            }, function(err) {
                let reject = __runtime_object_get(deferred, "reject");
                reject(err);
                return err;
