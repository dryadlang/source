@startuml
!pragma layout smetana dryad_10_intrinsics
title Dryad Language — Intrinsics Registry
skinparam backgroundColor #FEFEFE
skinparam shadowing false
skinparam defaultFontSize 9

class IntrinsicsRegistry {
  + register_intrinsic(name, func)
  + call(name) / call_by_id(id)
  --
  register_all() on startup
}

package "Registration Categories" as CAT #E3F2FD {
  class "register_file_io_intrinsics" as FIO
  class "register_filesystem_intrinsics" as FS
  class "register_memory_intrinsics" as MEM
  class "register_string_intrinsics" as STR
  class "register_time_intrinsics" as TIME
  class "register_process_intrinsics" as PROC
  class "register_network_intrinsics" as NET
  class "register_tls_intrinsics" as TLS
  class "register_thread_intrinsics" as THR
  class "register_event_loop_intrinsics" as EV
  class "register_poller_intrinsics" as POLL
  class "register_misc_intrinsics" as MISC
}

IntrinsicsRegistry --> CAT

package "File I/O" as P_FIO #FFF3E0 {
  card FIO_syscalls [
    open, read, write, close
    read_buffer, write_buffer
    fstat, fsync, unlink, stat
  ]
}

package "Filesystem" as P_FS #E8F5E9 {
  card FS_syscalls [
    mkdir, rmdir, lseek, rename
    getcwd, chdir, exists, filesize
    readdir, normalize_path
    open_read, open_write, open_append
    open_readwrite
  ]
}

package "Memory & Buffers" as P_MEM #F3E5F5 {
  card MEM_syscalls [
    malloc, free, realloc
    memcpy, memset
    alloc_bytes, free_bytes
    buffer_get, buffer_set
  ]
}

package "String" as P_STR #E0F7FA {
  card STR_syscalls [
    string_length, int_to_string
    string_to_bytes, bytes_to_string
    string_starts_with
  ]
}

package "Network" as P_NET #FCE4EC {
  card NET_syscalls [
    socket, connect, bind, listen
    accept, send, recv, shutdown
    send_buffer, recv_buffer
    sendto_buffer, recvfrom_buffer
    resolve_host, getsockname
    set_reuseaddr, get_errno
    set_nonblocking
  ]
}

package "TLS" as P_TLS #EDE7F6 {
  card TLS_syscalls [
    tls_available
    tls_client_handshake
    tls_send_buffer, tls_recv_buffer
    tls_close, tls_available_bytes
  ]
}

package "Threading" as P_THR #FFF3E0 {
  card THR_syscalls [
    thread_spawn, thread_join
    thread_spawn_async
    thread_pool_create/destroy
    thread_pool_submit/wait
    thread_hardware_concurrency
    thread_sleep_ms
  ]
}

package "Event Loop & Runtime" as P_RT #E3F2FD {
  card RT_syscalls [
    schedule_microtask
    event_loop_pending/pump_all/run_turn
    await_promise
    io_register_fd / io_unregister_fd
    io_poll_once
    --
    create_object, value_kind
    object_set/get/keys
    array_length, array_push
    get_stack_trace
  ]
}

package "Process & Time" as P_MISC #E8F5E9 {
  card MISC_syscalls [
    getpid, getenv, setenv
    sleep, exit
    time, clock_gettime
  ]
}

FIO --> P_FIO
FS --> P_FS
MEM --> P_MEM
STR --> P_STR
NET --> P_NET
TLS --> P_TLS
THR --> P_THR
EV --> P_RT
POLL --> P_RT
MISC --> P_RT
PROC --> P_MISC
TIME --> P_MISC

note bottom
  **Dryad surface syntax**
  @intrinsic("name") extern function ...
  **VM dispatch**: Opcode::INTRINSIC_SYSCALL + uint16 id
  **Design**: intrinsics = raw energy; @std/* = appliances
end note

@enduml
