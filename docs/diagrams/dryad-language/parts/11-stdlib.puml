@startuml
!pragma layout smetana dryad_11_stdlib
title Dryad Standard Library (@std/*)
skinparam backgroundColor #FEFEFE
skinparam packageStyle rectangle
skinparam shadowing false
skinparam defaultFontSize 9

legend top right
  |= Symbol |= Meaning |
  | **barrel** | Re-export aggregator module |
  | (iface) | Interface |
  | (abs) | Abstract class |
  | * | Key public API |
endlegend

package "@std" as STD #E8EAF6 {

  ' =========================================================================
  package "core" as CORE #E3F2FD {
    package "disposable" {
      interface IDisposable {
        + dispose(): void
      }
    }
    package "enumerable" {
      interface IEnumerable {
        + forEach(callback): void
      }
    }
    package "exceptions" {
      class Exception
      class ArgumentException
      class ArgumentNullException
      class ArgumentOutOfRangeException
      class IOException
      class FileNotFoundException
      class DirectoryNotFoundException
      class EndOfStreamException
      class InvalidOperationException
      class ObjectDisposedException
      class IndexOutOfRangeException
      class KeyNotFoundException
      class NetworkException
      class SocketException
      class HttpException
    }
  }

  ' =========================================================================
  package "buffers" as BUFFERS #FFF3E0 {
    package "buffer" as BUFFERS_BUF {
      class Buffer {
        * Buffer_New(size)
        * Buffer_FromPtr(ptr, size, owns)
        * Buffer_Len / Buffer_Capacity
        * Buffer_Read / Buffer_Write / Buffer_Fill
        * Buffer_Slice / Buffer_Resize / Buffer_CopyTo
        * Buffer_FromString / Buffer_AsString
        * Buffer_Dispose
      }
    }
  }

  ' =========================================================================
  package "collections" as COLL #E8F5E9 {
    package "collections.dryad **barrel**" as COLL_BARREL {
      note as _n1
        Re-exports: List, Map, Set, Queue
      end note
    }
    package "list" {
      class List implements IEnumerable {
        count, capacity
        get/set, add, insert
        remove, removeAt, clear
        contains, indexOf
        forEach, map, filter, reduce
      }
    }
    package "map" {
      class Map {
        size
        put, get, has, delete, clear
        forEach, keys(), values()
      }
    }
    package "set" {
      class Set implements IEnumerable {
        size
        add, delete, has, clear, forEach
      }
    }
    package "queue" {
      class Queue implements IEnumerable {
        count, capacity, isEmpty
        enqueue, dequeue, peek
        clear, forEach
      }
    }
  }

  ' =========================================================================
  package "io" as IO #F3E5F5 {
    package "stream" as IO_STREAM {
      abstract class Stream implements IDisposable {
        canRead, canWrite, canSeek
        length, position
        read, write, seek, flush
        close, dispose
      }
      class SeekOrigin {
        Begin
        Current
        End
      }
      card _api1 [
      Stream_isStream, Stream_isError
      ]
    }
    package "path" {
      class Path
      card _api2 [
        join, dirname, basename
        extension, ensureDirectory
        ensureParentForFile
      ]
    }
    package "io_errors" {
      card _api3 [
      InvalidPathError, FileNotFoundError
      DirectoryNotFoundError, AccessDeniedError
      FileAlreadyExistsError, InvalidOperationError
      NormalizePath, ValidatePath
      ]
    }
    package "vfs" as IO_VFS {
      interface FileSystemBackend
      class VFS {
        readFile, writeFile, listDirectory\nremoveFile, exists, mkdir, dispose
      }
      class MemoryBackend
      class NativeBackend
    }
    package "file" as IO_FILE {
      card _api4 [
      readFile, writeFile, exists
      removeFile, listDirectory, mkdir
      setVFSBackend
      readFileAsync, writeFileAsync, ...
      ]
    }
    package "filestream" {
      class FileMode {
        Read
        Write
        ReadWrite
        Append
      }
      class FileStream extends Stream
      card _api5 [
      File_open, File_exists, File_delete
      File_readAllText, File_writeAllText
      ]
    }
    package "memory_stream" {
      class MemoryStream extends Stream
      card _api6 [
      MemoryStream_new, MemoryStream_fromString
      MemoryStream_fromBuffer, MemoryStream_toString
      MemoryStream_getBuffer
      ]
    }
    package "filehandle" {
      class FileHandle
      card _api7 [
      FileHandle_read/write/close/dispose
      ]
    }
    package "io_concurrency" {
      class FileLock
      class ThreadSafeVFS
    }
  }

  ' =========================================================================
  package "async" as ASYNC #E0F7FA {
    package "async.dryad **barrel**" as ASYNC_BARREL {
      note as _n2
        Re-exports: Promise_*, Thread_*, ThreadPool_*, EventLoop_*
      end note
    }
    package "promise" as ASYNC_PROMISE {
      class Promise {
        then, catch/catchError
        finally/finallyDo
      }
      card _api8 [
      Promise_resolve, Promise_reject, Promise_wrap
      Promise_all, Promise_race, Promise_flush
      Promise_await
      ]
    }
    package "event_loop" as ASYNC_EVLOOP {
      card _api9 [
      EventLoop_schedule
      EventLoop_pendingCount
      EventLoop_pump, EventLoop_runTurn
      ]
    }
    package "threading" {
      package "thread" as ASYNC_THREAD {
        class Thread {
          start, join, isStarted
        }
        card _api10 [
        Thread_parallel, Thread_sleepMs
        Thread_hardwareConcurrency
        Thread_startAsync
        ]
      }
      package "thread_pool" {
        class ThreadPool {
          submit, wait, run\nsubmitAsync, destroy
        }
        card _api11 [
        ThreadPool_map
        ]
      }
      package "threading.dryad **barrel**" {
        note as _n3
          Re-exports thread + thread_pool
        end note
      }
    }
  }

  ' =========================================================================
  package "net" as NET #FCE4EC {
    package "net.dryad **barrel**" as NET_BARREL {
      note as _n4
        Re-exports: Socket*, Tcp*, Udp*, Dns, Tls*, HttpClient*
      end note
    }
    package "constants" {
      class SocketDomain {
        IPv4
        IPv6
      }
      class SocketType {
        Stream
        Datagram
      }
      class Shutdown {
        Read
        Write
        Both
      }
    }
    package "net_errors" {
      card _api12 [
      Net_validatePort, Net_validateConnectHost
      Net_normalizeBindHost, Net_socketError
      ]
    }
    package "dns" {
      card _api13 [
      Net_resolveHost
      Net_resolveHostOrError
      ]
    }
    package "socket" as NET_SOCKET {
      class Socket implements IDisposable {
        connect, bind, listen, accept
        send, receive, sendTo, receiveFrom
        shutdown, close, dispose
      }
      card _api14 [
      Socket_isSocket, Socket_fromFd
      ]
    }
    package "network_stream" {
      class NetworkStream extends Stream
      card _api15 [
      NetworkStream_fromSocket
      ]
    }
    package "tcp_client" as NET_TCP {
      class TcpClient implements IDisposable {
        getStream, send, receive
        close, dispose
      }
      card _api16 [
      TcpClient_connect, TcpClient_wrap
      ]
    }
    package "tcp_listener" {
      class TcpListener {
        start, accept, stop
      }
    }
    package "udp_client" {
      class UdpClient {
        sendTo, receiveFrom
      }
      card _api17 [
      UdpClient_create
      ]
    }
    package "tls_stream" as NET_TLS {
      class TlsStream extends Stream
      card _api18 [
      TlsStream_isAvailable, TlsStream_connect
      ]
    }
    package "socket_async" as NET_SOCK_ASYNC {
      note as _n5
        Not in net barrel
      end note
      card _api19 [
      Socket_connectAsync, Socket_sendAsync
      Socket_receiveAsync
      TcpClient_connectAsync
      ]
    }
    package "http" {
      package "http_string" {
        card _http_string [
          Http_charAt, Http_trim, ...
        ]
      }
      package "http_headers" {
        class HttpHeaders
      }
      package "http_url" {
        card _http_url [
          Http_parseUrl
        ]
      }
      package "http_request" {
        class HttpRequest
        class HttpRequest_buildWire
      }
      package "http_response" {
        class HttpResponse
        class HttpResponse_parse
      }
      package "http_client" as NET_HTTP {
        class HttpClient {
          send, get, post\ngetAsync, postAsync
        }
        card _api20 [
        HttpClient_create
        ]
      }
    }
  }
}

' =============================================================================
' Stdlib internal dependencies
' =============================================================================

CORE.IEnumerable <|.. COLL.list
CORE.IEnumerable <|.. COLL.set
CORE.IEnumerable <|.. COLL.queue
CORE.IDisposable <|.. IO_STREAM
CORE.IDisposable <|.. NET_SOCKET
CORE.IDisposable <|.. NET_TCP

COLL.map <-- COLL.set : backed by
IO_STREAM <|-- IO.filestream
IO_STREAM <|-- IO.memory_stream
IO_STREAM <|-- NET.network_stream
IO_STREAM <|-- NET_TLS

BUFFERS_BUF <-- IO.filestream : read/write bytes
BUFFERS_BUF <-- NET_SOCKET : buffer I/O
BUFFERS_BUF <-- NET_TLS

IO_VFS <-- IO_FILE : delegates
ASYNC_PROMISE <-- IO_FILE : *Async wrappers
ASYNC_PROMISE <-- NET_HTTP : getAsync/postAsync
ASYNC_EVLOOP <-- ASYNC_PROMISE : microtask settlement
ASYNC_EVLOOP <-- NET_SOCK_ASYNC

NET_SOCKET <-- NET_TCP
NET_TCP <-- NET_HTTP : HTTP transport
NET_TLS <-- NET_HTTP : HTTPS

' =============================================================================
' Stdlib → Core intrinsics layer
' =============================================================================

package "Compiler Intrinsics" as INTR #FFF9C4 {
  class Memory {
    __alloc_bytes, __free_bytes
    __buffer_get/set
  }
  class FS {
    __open_read/write, __read_buffer
    __exists, __mkdir, __readdir
  }
  class Net {
    __socket, __connect, __send_buffer
    __resolve_host
  }
  class TLS {
    __tls_client_handshake
    __tls_send_buffer
  }
  class Thread {
    __thread_spawn, __thread_pool_*
  }
  class Runtime {
    __runtime_schedule_microtask
    __runtime_await_promise
    __runtime_object_*
  }
}

BUFFERS_BUF ..> INTR.Memory
IO_VFS ..> INTR.FS
NET_SOCKET ..> INTR.Net
NET_TLS ..> INTR.TLS
ASYNC_THREAD ..> INTR.Thread
ASYNC_PROMISE ..> INTR.Runtime

note bottom of STD
  **46 .dryad files** under stdlib/@std/
  **Error model**: functions return exception string values (no throw in stdlib)
  **VFS**: MemoryBackend for tests, NativeBackend for production
  **Buffer**: universal byte container for I/O and networking
end note

@enduml
