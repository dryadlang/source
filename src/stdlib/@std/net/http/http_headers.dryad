// @std/net/http/http_headers.dryad
// HTTP header collection

import { Map } from "@std/collections/map";
import { _Http_charAt, _Http_substring, _Http_toLowerAscii, _Http_indexOf } from "@std/net/http/http_string";
import { ArgumentException } from "@std/core/exceptions";

// Error message for a header name or value that cannot go on the wire, or null.
// CR/LF would end the header early and let the value inject more headers.
function _HttpHeaders_invalid(label, text) {
    if (__runtime_value_kind(text) != "string") {
        return ArgumentException("Header " + label + " must be a string");
    }
    if (_Http_indexOf(text, "\r") >= 0 || _Http_indexOf(text, "\n") >= 0) {
        return ArgumentException("Header " + label + " must not contain CR or LF");
    }
    return null;
}

// Header names are case-insensitive (RFC 9110): lookups ignore case, and the
// name as last set is kept for writing the request.
class HttpHeaders {
    constructor() {
        this._map = new Map();
        this._names = new Map();
    }

    set(name, value) {
        let err = _HttpHeaders_invalid("name", name);
        if (err == null) {
            err = _HttpHeaders_invalid("value", value);
        }
        if (err != null) {
            return err;
        }
        let key = _Http_toLowerAscii(name);
        this._map.put(key, value);
        this._names.put(key, name);
        return null;
    }

    get(name) {
        return this._map.get(_Http_toLowerAscii(name));
    }

    has(name) {
        return this._map.has(_Http_toLowerAscii(name));
    }

    forEach(callback) {
        let names = this._names;
        this._map.forEach(function(key, value) {
            callback(names.get(key), value);
            return null;
        });
        return null;
    }
}

function _HttpHeaders_fromLines(lines) {
    let headers = new HttpHeaders();
    let i = 0;
    let count = __runtime_array_length(lines);
    while (i < count) {
        let line = lines[i];
        let colon = _HttpHeaders_indexOfColon(line);
        if (colon > 0) {
            let name = _Http_substring(line, 0, colon);
            let value = _HttpHeaders_trim(_Http_substring(line, colon + 1, __string_length(line)));
            headers.set(name, value);
        }
        i = i + 1;
    }
    return headers;
}

function _HttpHeaders_indexOfColon(text) {
    let i = 0;
    let len = __string_length(text);
    while (i < len) {
        if (_Http_charAt(text, i) == ":") {
            return i;
        }
        i = i + 1;
    }
    return -1;
}

function _HttpHeaders_trim(text) {
    let start = 0;
    let end = __string_length(text);
    let trimmingStart = true;
    while (start < end && trimmingStart) {
        let ch = _Http_charAt(text, start);
        if (ch == " " || ch == "\t") {
            start = start + 1;
        } else {
            trimmingStart = false;
        }
    }
    let trimmingEnd = true;
    while (end > start && trimmingEnd) {
        let ch = _Http_charAt(text, end - 1);
        if (ch == " " || ch == "\t") {
            end = end - 1;
        } else {
            trimmingEnd = false;
        }
    }
    return _Http_substring(text, start, end);
}
