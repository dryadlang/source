// @std/net/http/http_string.dryad
// String helpers for HTTP parsing

function _Http_charAt(text, index) {
    let len = __string_length(text);
    let handle = __alloc_bytes(len);
    __string_to_bytes(text, handle, 0);
    let ch = __bytes_to_string(handle, index, 1);
    __free_bytes(handle);
    return ch;
}

function _Http_startsWith(text, prefix) {
    let prefixLen = __string_length(prefix);
    let textLen = __string_length(text);
    if (prefixLen > textLen) {
        return false;
    }
    let i = 0;
    while (i < prefixLen) {
        if (_Http_charAt(text, i) != _Http_charAt(prefix, i)) {
            return false;
        }
        i = i + 1;
    }
    return true;
}

function _Http_indexOf(text, needle) {
    let textLen = __string_length(text);
    let needleLen = __string_length(needle);
    if (needleLen == 0) {
        return 0;
    }
    let i = 0;
    while (i <= textLen - needleLen) {
        let j = 0;
        let match = true;
        while (j < needleLen) {
            if (_Http_charAt(text, i + j) != _Http_charAt(needle, j)) {
                match = false;
            }
            j = j + 1;
        }
        if (match) {
            return i;
        }
        i = i + 1;
    }
    return -1;
}

function _Http_substring(text, start, end) {
    let len = end - start;
    if (len <= 0) {
        return "";
    }
    let handle = __alloc_bytes(len);
    let i = 0;
    let textHandle = __alloc_bytes(__string_length(text));
    __string_to_bytes(text, textHandle, 0);
    while (i < len) {
        let byte = __buffer_get(textHandle, start + i);
        __buffer_set(handle, i, byte);
        i = i + 1;
    }
    __free_bytes(textHandle);
    let result = __bytes_to_string(handle, 0, len);
    __free_bytes(handle);
    return result;
}

function _Http_trim(text) {
    let start = 0;
    let end = __string_length(text);
    let trimmingStart = true;
    while (start < end && trimmingStart) {
        let ch = _Http_charAt(text, start);
        if (ch == " " || ch == "\t" || ch == "\r" || ch == "\n") {
            start = start + 1;
        } else {
            trimmingStart = false;
        }
    }
    let trimmingEnd = true;
    while (end > start && trimmingEnd) {
        let ch = _Http_charAt(text, end - 1);
        if (ch == " " || ch == "\t" || ch == "\r" || ch == "\n") {
            end = end - 1;
        } else {
            trimmingEnd = false;
        }
    }
    return _Http_substring(text, start, end);
}

// ASCII-only lowercase (header names are ASCII); other bytes are unchanged.
function _Http_toLowerAscii(text) {
    let len = __string_length(text);
    if (len == 0) {
        return "";
    }
    let handle = __alloc_bytes(len);
    __string_to_bytes(text, handle, 0);
    let i = 0;
    while (i < len) {
        let b = __buffer_get(handle, i);
        if (b >= 65 && b <= 90) {
            __buffer_set(handle, i, b + 32);
        }
        i = i + 1;
    }
    let result = __bytes_to_string(handle, 0, len);
    __free_bytes(handle);
    return result;
}

// Value of one hex digit byte (0-9, a-f, A-F), or -1.
function _Http_hexDigit(b) {
    if (b >= 48 && b <= 57) {
        return b - 48;
    }
    if (b >= 97 && b <= 102) {
        return b - 87;
    }
    if (b >= 65 && b <= 70) {
        return b - 55;
    }
    return -1;
}
