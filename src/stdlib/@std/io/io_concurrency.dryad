// @std/io/io_concurrency.dryad
// Cooperative lock wrapper for shared VFS access (single-threaded runtime today)

import {
    VFS,
    VFS_ReadFile,
    VFS_readFile,
    VFS_WriteFile,
    VFS_writeFile,
    VFS_Exists,
    VFS_exists,
    VFS_RemoveFile,
    VFS_removeFile,
    VFS_RenameFile,
    VFS_ListDirectory,
    VFS_listDirectory,
    VFS_Mkdir,
    VFS_mkdir
} from "@std/io/vfs";
import { ArgumentNullException, InvalidOperationException } from "@std/core/exceptions";

function FileLock() {
    let lock = __runtime_create_object();
    __runtime_object_set(lock, "locked", false);
    return lock;
}

function FileLock_Acquire(lock) {
    if (lock == null) {
        return ArgumentNullException("lock");
    }
    if (__runtime_object_get(lock, "locked") == true) {
        return InvalidOperationException("FileLock already held");
    }
    __runtime_object_set(lock, "locked", true);
    return null;
}

function FileLock_Release(lock) {
    __runtime_object_set(lock, "locked", false);
    return null;
}

function ThreadSafeVFS(backend) {
    let vfs = VFS(backend);
    __runtime_object_set(vfs, "lock", FileLock());
    return vfs;
}

function _ThreadSafeVFS_withLock(vfs, operation) {
    let lock = __runtime_object_get(vfs, "lock");
    let err = FileLock_Acquire(lock);
    if (err != null) {
        return err;
    }
    let result = operation();
    FileLock_Release(lock);
    return result;
}

function ThreadSafeVFS_ReadFile(vfs, path) {
    return _ThreadSafeVFS_withLock(vfs, function() {
        return VFS_ReadFile(vfs, path);
    });
}

function ThreadSafeVFS_WriteFile(vfs, path, content) {
    return _ThreadSafeVFS_withLock(vfs, function() {
        return VFS_WriteFile(vfs, path, content);
    });
}

function ThreadSafeVFS_Exists(vfs, path) {
    return _ThreadSafeVFS_withLock(vfs, function() {
        return VFS_Exists(vfs, path);
    });
}

function ThreadSafeVFS_RemoveFile(vfs, path) {
    return _ThreadSafeVFS_withLock(vfs, function() {
        return VFS_RemoveFile(vfs, path);
    });
}

function ThreadSafeVFS_RenameFile(vfs, oldPath, newPath) {
    return _ThreadSafeVFS_withLock(vfs, function() {
        return VFS_RenameFile(vfs, oldPath, newPath);
    });
}

function ThreadSafeVFS_ListDirectory(vfs, path) {
    return _ThreadSafeVFS_withLock(vfs, function() {
        return VFS_ListDirectory(vfs, path);
    });
}

function ThreadSafeVFS_Mkdir(vfs, path) {
    return _ThreadSafeVFS_withLock(vfs, function() {
        return VFS_Mkdir(vfs, path);
    });
}

// Deprecated pre-convention names, kept so existing code keeps working.
// They will be removed in a future release; use the names on the right.
// @deprecated Use FileLock_Acquire.
let FileLock_acquire = FileLock_Acquire;
// @deprecated Use FileLock_Release.
let FileLock_release = FileLock_Release;
// @deprecated Use ThreadSafeVFS_Exists.
let ThreadSafeVFS_exists = ThreadSafeVFS_Exists;
// @deprecated Use ThreadSafeVFS_ListDirectory.
let ThreadSafeVFS_listDirectory = ThreadSafeVFS_ListDirectory;
// @deprecated Use ThreadSafeVFS_Mkdir.
let ThreadSafeVFS_mkdir = ThreadSafeVFS_Mkdir;
// @deprecated Use ThreadSafeVFS_ReadFile.
let ThreadSafeVFS_readFile = ThreadSafeVFS_ReadFile;
// @deprecated Use ThreadSafeVFS_RemoveFile.
let ThreadSafeVFS_removeFile = ThreadSafeVFS_RemoveFile;
// @deprecated Use ThreadSafeVFS_WriteFile.
let ThreadSafeVFS_writeFile = ThreadSafeVFS_WriteFile;
