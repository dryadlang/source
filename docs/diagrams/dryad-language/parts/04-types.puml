@startuml
!pragma layout smetana dryad_04_types
title Dryad Language — Type System
skinparam backgroundColor #FEFEFE
skinparam shadowing false
skinparam defaultFontSize 10

package "Runtime Value Types" as RT #E3F2FD {
  enum ValueType {
    Null
    Boolean
    Integer     // int64
    Float       // double
    String
    Array
    Object      // string-keyed map
    Function
    Class
    Instance
  }

  class Value {
    + type(): ValueType
    + is_truthy(): bool
    + to_string(): string
    --
    Array ops: push, get, set, length
    Object ops: set, get, has, keys
    as_boolean / as_integer / as_float
    as_string / as_function / as_class / as_instance
  }
}

package "Compile-Time Profiling" as PROF #FFF3E0 {
  enum TypeConfidence {
    STATIC
    OBSERVED
    UNKNOWN
  }

  enum ObservedType {
    Null, Bool, I32, F64
    String, Array, Object
    Function, Class, Instance
    Any
  }

  class SlotProfile {

    + type, confidence, observation_count

  }
  class BranchProfile {
    + taken, not_taken
  }
  class CallSiteProfile {
    + callee_name, call_count
  }
  class FunctionProfile {
    + name, slots array, branches array, call_sites array
  }
  class TypeProfiler {
    + observe_slot()
    + observe_branch()
    + observe_call()
    + from_value() / from_annotation()
  }
}

package "Semantic Annotations" as SEM #E8F5E9 {
  class SemanticAnalyzer {
    + known_types: number, boolean, string, void, byte
    + user class/interface names
    + infer_literal_type()
    + infer_binary_type()
    + is_assignable()
  }
  class Scope {
    + symbols: SymbolInfo array
  }
  class SymbolInfo {
    + name, type, used
  }
  class FunctionSignature {
    + param_types array, return_type
  }
}

package "Bytecode Slot Metadata" as BC_META #F3E5F5 {
  class SlotMetadata {
    + name, slot_index
    + type: ObservedType
    + confidence: TypeConfidence
  }
  class FunctionMetadata {
    + name, slots array
    + parameter_count, stack_depth, opcode_count
  }
}

package "Micro-IR Types (AOT)" as IR #E0F7FA {
  enum IrType {
    Void, I32, F64, Bool, Ptr, Variant
  }
}

Value --> ValueType
TypeProfiler --> ObservedType
TypeProfiler --> TypeConfidence
SlotMetadata --> ObservedType
FunctionProfile --> SlotProfile

note bottom of PROF
  Profiler runs during interpreter execute pass
  Guides specialized opcodes (ADD_I32, ADD_F64, etc.)
end note

note bottom of SEM
  Type annotations on params/returns are optional
  Inference + observation drive bytecode specialization
end note

@enduml
