// @std/net/http/http_response.dryad
// HTTP response parser

import { HttpHeaders, _HttpHeaders_fromLines } from "@std/net/http/http_headers";
import { _Http_indexOf, _Http_substring, _Http_trim, _Http_startsWith, _Http_charAt, _Http_toLowerAscii, _Http_hexDigit } from "@std/net/http/http_string";
import { ArgumentException } from "@std/core/exceptions";

class HttpResponse {
    constructor(statusCode, statusText, headers, body) {
        this.statusCode = statusCode;
        this.statusText = statusText;
        this.headers = headers;
        this.body = body;
    }
}

function HttpResponse_Parse(raw) {
    if (raw == null || raw == "") {
        return ArgumentException("Empty HTTP response");
    }

    let headerEnd = _Http_indexOf(raw, "\r\n\r\n");
    if (headerEnd < 0) {
        return ArgumentException("Malformed HTTP response");
    }

    let headerBlock = _Http_substring(raw, 0, headerEnd);
    let body = _Http_substring(raw, headerEnd + 4, __string_length(raw));

    let lines = _HttpResponse_splitLines(headerBlock);
    if (__runtime_array_length(lines) < 1) {
        return ArgumentException("Malformed HTTP status line");
    }

    let statusLine = lines[0];
    let statusParts = _HttpResponse_parseStatusLine(statusLine);
    if (statusParts == null) {
        return ArgumentException("Malformed HTTP status line");
    }

    let headerLines = [];
    let i = 1;
    while (i < __runtime_array_length(lines)) {
        __runtime_array_push(headerLines, lines[i]);
        i = i + 1;
    }

    let headers = _HttpHeaders_fromLines(headerLines);
    let encoding = headers.get("Transfer-Encoding");
    if (encoding != null && _Http_indexOf(_Http_toLowerAscii(encoding), "chunked") >= 0) {
        body = _HttpResponse_decodeChunked(body);
        if (body == null) {
            return ArgumentException("Malformed chunked HTTP body");
        }
    }
    return new HttpResponse(statusParts[0], statusParts[1], headers, body);
}

// Decodes a `Transfer-Encoding: chunked` body: hex size line (extensions
// after `;` ignored), CRLF, data, CRLF, ... ending with a zero-size chunk.
// Trailers after the last chunk are dropped. Returns null when malformed or
// truncated. Sizes count bytes, so the body is walked as bytes.
function _HttpResponse_decodeChunked(body) {
    let len = __string_length(body);
    if (len == 0) {
        return null;
    }
    let handle = __alloc_bytes(len);
    __string_to_bytes(body, handle, 0);
    let out = "";
    let pos = 0;
    let result = null;
    let done = false;
    while (!done && pos < len) {
        let size = 0;
        let digits = 0;
        let inExtension = false;
        let valid = true;
        while (pos < len && __buffer_get(handle, pos) != 13) {
            let b = __buffer_get(handle, pos);
            if (b == 59) {
                inExtension = true;
            }
            if (!inExtension) {
                let digit = _Http_hexDigit(b);
                if (digit >= 0) {
                    size = size * 16 + digit;
                    digits = digits + 1;
                } else if (b != 32 && b != 9) {
                    valid = false;
                }
            }
            pos = pos + 1;
        }
        if (!valid || digits == 0 || pos + 1 >= len) {
            done = true;
        } else {
            pos = pos + 2;
            if (size == 0) {
                result = out;
                done = true;
            } else if (pos + size > len) {
                done = true;
            } else {
                out = out + __bytes_to_string(handle, pos, size);
                pos = pos + size + 2;
            }
        }
    }
    __free_bytes(handle);
    return result;
}

function _HttpResponse_splitLines(block) {
    let lines = [];
    let current = "";
    let i = 0;
    let len = __string_length(block);
    while (i < len) {
        let ch = _Http_charAt(block, i);
        if (ch == "\r" && i + 1 < len && _Http_charAt(block, i + 1) == "\n") {
            __runtime_array_push(lines, current);
            current = "";
            i = i + 2;
        } else {
            current = current + ch;
            i = i + 1;
        }
    }
    if (current != "") {
        __runtime_array_push(lines, current);
    }
    return lines;
}

function _HttpResponse_parseStatusLine(line) {
    if (!_Http_startsWith(line, "HTTP/")) {
        return null;
    }
    let firstSpace = _Http_indexOf(line, " ");
    if (firstSpace < 0) {
        return null;
    }
    let secondSpace = _Http_indexOf(_Http_substring(line, firstSpace + 1, __string_length(line)), " ");
    let codeText = _Http_substring(line, firstSpace + 1, firstSpace + 4);
    let code = _HttpResponse_parseInt(codeText);
    let text = _Http_trim(_Http_substring(line, firstSpace + 4, __string_length(line)));
    return [code, text];
}

function _HttpResponse_parseInt(text) {
    let value = 0;
    let i = 0;
    let len = __string_length(text);
    let handle = __alloc_bytes(len);
    __string_to_bytes(text, handle, 0);
    while (i < len) {
        let byte = __buffer_get(handle, i);
        if (byte < 48 || byte > 57) {
            __free_bytes(handle);
            return 0;
        }
        value = value * 10 + (byte - 48);
        i = i + 1;
    }
    __free_bytes(handle);
    return value;
}

// Deprecated pre-convention names, kept so existing code keeps working.
// They will be removed in a future release; use the names on the right.
// @deprecated Use HttpResponse_Parse.
let HttpResponse_parse = HttpResponse_Parse;
