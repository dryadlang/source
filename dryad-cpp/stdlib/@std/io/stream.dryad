// @std/io/stream.dryad
// Abstract Stream API for sequential I/O

import { IDisposable } from "@std/core/disposable";

abstract class Stream implements IDisposable {
    abstract readonly canRead: boolean;
    abstract readonly canWrite: boolean;
    abstract readonly canSeek: boolean;
    abstract readonly length: number;
    abstract position: number;

    abstract read(buffer, offset, count);
    abstract write(buffer, offset, count);
    abstract seek(offset, origin);
    abstract flush();
    abstract close();

    dispose() {
        this.close();
    }
}

// SeekOrigin constants (POSIX whence values)
let SeekOrigin_Begin = 0;
let SeekOrigin_Current = 1;
let SeekOrigin_End = 2;

function SeekOrigin_Create() {
    let origin = __runtime_create_object();
    __runtime_object_set(origin, "Begin", 0);
    __runtime_object_set(origin, "Current", 1);
    __runtime_object_set(origin, "End", 2);
    return origin;
}

let SeekOrigin = SeekOrigin_Create();

function Stream_isStream(value) {
    if (value == null) {
        return false;
    }
    return value.canRead != null && value.read != null && value.close != null;
}

function Stream_isError(value) {
    return !Stream_isStream(value);
}
