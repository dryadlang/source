{
  "version": 1,
  "binary": "build/bin/dryad",
  "stdlib": "stdlib",
  "examples": [
    {
      "id": "lang-basics",
      "path": "01-language/basics.dryad",
      "category": "language",
      "description": "Literals, arithmetic, comparison, logical operators",
      "flags": []
    },
    {
      "id": "lang-control-flow",
      "path": "01-language/control_flow.dryad",
      "category": "language",
      "description": "if/else, while, for-in",
      "flags": []
    },
    {
      "id": "lang-functions",
      "path": "01-language/functions.dryad",
      "category": "language",
      "description": "Functions, closures, recursion",
      "flags": []
    },
    {
      "id": "lang-classes",
      "path": "01-language/classes.dryad",
      "category": "language",
      "description": "Classes, inheritance, methods",
      "flags": []
    },
    {
      "id": "lang-compile-decorator",
      "path": "01-language/compile_decorator.dryad",
      "category": "tooling",
      "description": "@compile(\"bytecode\") decorator",
      "flags": []
    },
    {
      "id": "buffers-usage",
      "path": "02-buffers/buffer_usage.dryad",
      "category": "buffers",
      "description": "Buffer string/byte conversion, slice, write",
      "flags": []
    },
    {
      "id": "collections-usage",
      "path": "03-collections/collections_usage.dryad",
      "category": "collections",
      "description": "List, Map, Set, Queue",
      "flags": []
    },
    {
      "id": "io-vfs",
      "path": "04-io/io_examples.dryad",
      "category": "io",
      "description": "VFS, file API, FileHandle",
      "flags": []
    },
    {
      "id": "io-native",
      "path": "04-io/file_io_usage.dryad",
      "category": "io",
      "description": "NativeBackend filesystem roundtrip",
      "flags": []
    },
    {
      "id": "io-streams",
      "path": "04-io/stream_usage.dryad",
      "category": "io",
      "description": "MemoryStream, FileStream, Path",
      "flags": []
    },
    {
      "id": "io-paths",
      "path": "04-io/paths.dryad",
      "category": "io",
      "description": "Path join, dirname, basename, extension",
      "flags": []
    },
    {
      "id": "async-promises",
      "path": "05-async/promises.dryad",
      "category": "async",
      "description": "Promise resolve/reject/then/all/race",
      "flags": []
    },
    {
      "id": "async-await",
      "path": "05-async/async_await.dryad",
      "category": "async",
      "description": "async/await and microtask ordering",
      "flags": []
    },
    {
      "id": "async-threading",
      "path": "05-async/threading.dryad",
      "category": "async",
      "description": "Thread, ThreadPool, parallel",
      "flags": []
    },
    {
      "id": "net-tcp-client",
      "path": "06-net/tcp_client.dryad",
      "category": "net",
      "description": "TCP echo client (needs echo server on :9090)",
      "flags": ["--allow-net"],
      "optional": true
    },
    {
      "id": "net-http-parse",
      "path": "06-net/http_parse.dryad",
      "category": "net",
      "description": "HTTP URL/response parsing (no network)",
      "flags": []
    },
    {
      "id": "libraries-usage",
      "path": "08-libraries/library_usage.dyd",
      "category": "libraries",
      "description": "Import Vec2 from @test/geom via DRYAD_LIBRARY_PATH",
      "flags": [],
      "env": {
        "DRYAD_LIBRARY_PATH": "tests/fixtures/libs"
      }
    },
    {
      "id": "turing-dryadsquare",
      "path": "dryadsquare/dryadsquare.dryad",
      "category": "tooling",
      "description": "DryadSquare mini-compiler Turing-completeness benchmark",
      "flags": []
    }
  ],
  "tooling": [
    {
      "id": "check-syntax",
      "command": "check",
      "target": "07-tooling/check_syntax.dryad",
      "description": "Syntax validation"
    },
    {
      "id": "compile-bytecode",
      "command": "compile",
      "target": "01-language/compile_decorator.dryad",
      "output": "/tmp/dryad_example.dryadc",
      "description": "Bytecode compilation to .dryadc"
    },
    {
      "id": "analyze-paths",
      "command": "analyze",
      "target": "01-language/compile_decorator.dryad",
      "description": "Fast/slow path analysis"
    },
    {
      "id": "compile-aot",
      "command": "compile",
      "target": "01-language/compile_decorator.dryad",
      "output": "/tmp/dryad_example.ll",
      "flags": ["--aot"],
      "description": "AOT LLVM IR generation"
    }
  ]
}
