// Error handling tests for VFS and path normalization.

import {
    VFS,
    MemoryBackend,
    VFS_ReadFile,
    VFS_WriteFile,
    VFS_Dispose
} from "@std/io/vfs";

import { NormalizePath } from "@std/io/io_errors";

function test_error_on_missing_file() {
    let vfs = VFS(MemoryBackend());
    let result = VFS_ReadFile(vfs, "/nonexistent.txt");
    return result != null;
}

function test_error_on_invalid_path() {
    let vfs = VFS(MemoryBackend());
    let result = VFS_WriteFile(vfs, "", "content");
    return result != null;
}

function test_error_on_disposed_vfs() {
    let vfs = VFS(MemoryBackend());
    VFS_Dispose(vfs);
    let result = VFS_ReadFile(vfs, "/test.txt");
    return result != null;
}

function test_cross_platform_path_separators() {
    let vfs = VFS(MemoryBackend());
    VFS_WriteFile(vfs, "data\\file.txt", "test");
    let result = VFS_ReadFile(vfs, "data/file.txt");
    return result == "test";
}

function test_normalize_path_helper() {
    return NormalizePath("a\\b\\c") == "a/b/c";
}

function test_dotdot_is_one_file() {
    let vfs = VFS(MemoryBackend());
    VFS_WriteFile(vfs, "/tmp/../hello.txt", "x");
    return VFS_ReadFile(vfs, "/hello.txt") == "x";
}

function test_nul_byte_path_is_rejected() {
    let vfs = VFS(MemoryBackend());
    let raw = __alloc_bytes(3);
    __buffer_set(raw, 0, 97);
    __buffer_set(raw, 1, 0);
    __buffer_set(raw, 2, 98);
    let path = __bytes_to_string(raw, 0, 3);
    __free_bytes(raw);
    let err = VFS_WriteFile(vfs, path, "x");
    return err != null && VFS_ReadFile(vfs, "/a") != "x";
}
