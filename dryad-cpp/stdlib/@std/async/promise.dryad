class Promise {
    constructor(executor) {
        this._state = "pending";
        this._value = null;
        this._error = null;
        this._callbacks = [];

        let self = this;

        function resolve(value) {
            if (self._state != "pending") {
                return null;
            }
            self._state = "fulfilled";
            self._value = value;
            Promise_flushFulfilled(self);
            return null;
        }

        function reject(error) {
            if (self._state != "pending") {
                return null;
            }
            self._state = "rejected";
            self._error = error;
            Promise_flushRejected(self);
            return null;
        }

        executor(resolve, reject);
    }

    then(onFulfilled, onRejected = null) {
        if (this._state == "rejected") {
            if (onRejected != null) {
                return Promise_resolve(onRejected(this._error));
            }
            return Promise_wrap(this);
        }
        if (this._state == "fulfilled") {
            if (onFulfilled != null) {
                return Promise_resolve(onFulfilled(this._value));
            }
            return Promise_resolve(this._value);
