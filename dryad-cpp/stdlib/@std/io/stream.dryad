// @std/io/stream.dryad
// Abstract Stream API for sequential I/O

import { IDisposable } from "@std/core/disposable";

abstract class Stream implements IDisposable {
    abstract readonly canRead: boolean;
    abstract readonly canWrite: boolean;
    abstract readonly canSeek: boolean;
    abstract readonly length: number;
    abstract position: number;

    abstract read(buffer, offset, count);
    abstract write(buffer, offset, count);
    abstract seek(offset, origin);
    abstract flush();
    abstract close();

    dispose() {
        this.close();
    }
}
